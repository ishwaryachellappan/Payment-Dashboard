<mvc:View
    controllerName="payment.dashboard.controller.Exceptions"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
<VBox
    id="_IDGenVBox4"
    width="100%"
    class="sapUiTinyMargin">

    <!-- ✅ KPI ROW -->
    <ScrollContainer
        id="_IDGenScrollContainer2"
        horizontal="false"
        vertical="false"
        class="sapUiSmallMarginBottom"
        width="100%"
        height="auto"
    >
        <VBox
            id="_IDGenVBox119"
            class="kpiSectionContainer"
        >
                    <!-- KPI SECTION -->

                 <FlexBox
    id="_IDGenFlexBox"
    wrap="NoWrap"
    fitContainer="true"
    renderType="Bare"
    justifyContent="SpaceBetween"
    alignItems="Stretch"
    width="100%"
    class="kpiSummaryRow">

    <!-- OPEN EXCEPTIONS -->
<!-- OPEN EXCEPTIONS -->
<VBox
    id="_IDGenKpiOpenExceptions"
    class="kpiCard"
    width="100%"
    height="100%"
>
    <!-- KPI Label -->
    <Text
        id="_IDGenKpiOpenExceptionsLabel"
        text="Open Exceptions"
        class="kpiCardLabel"
    />

    <!-- KPI Value + Icon -->
    <HBox
        id="_IDGenKpiOpenExceptionsValueRow"
        class="kpiValueRow"
        alignItems="Center"
        justifyContent="SpaceBetween"
    >
        <Text
            id="_IDGenKpiOpenExceptionsValue"
            text="{exceptionKpiModel>/OpenException}"
            class="kpiCardValue kpiValueRed"
        />

        <HBox
            id="_IDGenKpiOpenExceptionsIconBox"
            class="kpiIconBox kpiIconRed"
            alignItems="Center"
            justifyContent="Center"
        >
            <core:Icon
                id="_IDGenKpiOpenExceptionsIcon"
                src="sap-icon://alert"
            />
        </HBox>
    </HBox>

    <!-- Comparison -->
    <Text
        id="_IDGenKpiOpenExceptionsSub"
        text="{ path: 'exceptionKpiModel>/openExceptionTrend', formatter: '.formatOpenExceptionTrendText' }"
        class="{ path: 'exceptionKpiModel>/openExceptionTrend', formatter: '.formatOpenExceptionTrendClass' }"
    />
</VBox>

<!-- VALUE AT RISK -->
<!-- VALUE AT RISK -->
<VBox
    id="_IDGenKpiValueAtRisk"
    class="kpiCard kpiCardNoClick"
    width="100%"
    height="100%"
>
    <!-- KPI Label -->
    <Text
        id="_IDGenKpiValueAtRiskLabel"
        text="Value at Risk"
        class="kpiCardLabel"
    />

    <!-- KPI Value + Icon -->
    <HBox
        id="_IDGenKpiValueAtRiskValueRow"
        class="kpiValueRow"
        alignItems="Center"
        justifyContent="SpaceBetween"
    >
        <Text
            id="_IDGenKpiValueAtRiskValue"
            text="{ path: 'exceptionKpiModel>/ValueAtRisk', formatter: '.formatValueAtRisk' }"
            class="kpiCardValue kpiValueOrange"
        />

        <HBox
            id="_IDGenKpiValueAtRiskIconBox"
            class="kpiIconBox kpiIconOrange"
            alignItems="Center"
            justifyContent="Center"
        >
            <core:Icon
                id="_IDGenKpiValueAtRiskIcon"
                src="sap-icon://money-bills"
            />
        </HBox>
    </HBox>

    <!-- Comparison -->
    <Text
        id="_IDGenKpiValueAtRiskSub"
        text="{ path: 'exceptionKpiModel>/valueAtRiskTrend', formatter: '.formatValueAtRiskTrendText' }"
        class="{ path: 'exceptionKpiModel>/valueAtRiskTrend', formatter: '.formatValueAtRiskTrendClass' }"
    />
</VBox>

   <!-- AWAITING APPROVAL -->
<!-- AWAITING APPROVAL -->
<VBox
    id="_IDGenKpiAwaitingApproval"
    class="kpiCard kpiCardNoClick"
    width="100%"
    height="100%"
>
    <Text
        id="_IDGenKpiAwaitingApprovalLabel"
        text="Awaiting Approval"
        class="kpiCardLabel"
    />

    <HBox
        id="_IDGenKpiAwaitingApprovalValueRow"
        class="kpiValueRow"
        alignItems="Center"
        justifyContent="SpaceBetween"
    >
        <Text
            id="_IDGenKpiAwaitingApprovalValue"
            text="147"
            class="kpiCardValue kpiValuePurple"
        />

        <HBox
            id="_IDGenKpiAwaitingApprovalIconBox"
            class="kpiIconBox kpiIconPurple"
            alignItems="Center"
            justifyContent="Center"
        >
            <core:Icon
                id="_IDGenKpiAwaitingApprovalIcon"
                src="sap-icon://pending"
            />
        </HBox>
    </HBox>

   <Text
    id="_IDGenKpiAwaitingApprovalSub"
    text="Insufficient data to compare"
    class="kpiCardSubtext"
/>
</VBox>

<!-- SANCTIONS HOLDS -->
<!-- SANCTIONS HOLDS -->
<VBox
    id="_IDGenKpiSanctionsHolds"
    class="kpiCard kpiCardNoClick"
    width="100%"
    height="100%"
>
    <Text
        id="_IDGenKpiSanctionsHoldsLabel"
        text="Sanctions Holds"
        class="kpiCardLabel"
    />

    <HBox
        id="_IDGenKpiSanctionsHoldsValueRow"
        class="kpiValueRow"
        alignItems="Center"
        justifyContent="SpaceBetween"
    >
        <Text
            id="_IDGenKpiSanctionsHoldsValue"
            text="38"
            class="kpiCardValue kpiValueDarkRed"
        />

        <HBox
            id="_IDGenKpiSanctionsHoldsIconBox"
            class="kpiIconBox kpiIconDarkRed"
            alignItems="Center"
            justifyContent="Center"
        >
            <core:Icon
                id="_IDGenKpiSanctionsHoldsIcon"
                src="sap-icon://shield"
            />
        </HBox>
    </HBox>

   <Text
    id="_IDGenKpiSanctionsHoldsSub"
    text="Insufficient data to compare"
    class="kpiCardSubtext"
/>
</VBox>

</FlexBox>

                </VBox>
            </ScrollContainer>
      

        <!-- // ADD BY Trend CARDS -->

        <HBox
            id="_IDGenHBox43"
            justifyContent="SpaceBetween"
            class="sapUiMediumMarginTop"
        >
            <!-- Trend -->
    
          <!-- ========================================================= -->
<!-- EXCEPTION TREND                                           -->
<!-- ========================================================= -->

<VBox
    id="_IDGenVBox37"
    width="40%"
    height="420px"
    class="chartCard exceptionTrendCard"
>

    <!-- ===================================================== -->
    <!-- HEADER                                                -->
    <!-- ===================================================== -->

    <HBox
        id="_IDGenTrendHeaderRow"
        width="100%"
        justifyContent="SpaceBetween"
        alignItems="Center"
        class="exceptionChartHeader"
    >

        <!-- LEFT -->

        <HBox
            id="trendHeaderLeft"
            alignItems="Center"
            class="exceptionChartHeaderLeft"
        >

            <HBox
                id="trendHeaderIconBox"
                alignItems="Center"
                justifyContent="Center"
                class="exceptionChartHeaderIcon"
            >

                <core:Icon
                    id="trendHeaderIcon"
                    src="sap-icon://bar-chart"
                />

            </HBox>


            <VBox
                id="_IDGenTrendTitleBox"
                class="exceptionChartTitleBox"
            >

                <Title
                    id="_IDGenTitle5"
                    text="Exception Trend (Last 7 Days)"
                    class="exceptionChartTitle"
                />

                <Text
                    id="_IDGenText84"
                    text="Opened vs Resolved · Daily Volume"
                    class="exceptionChartSubtitle"
                />

            </VBox>

        </HBox>


        <!-- RIGHT CONTROLS -->

        <HBox
            id="_IDGenTrendControlsGroup"
            alignItems="Center"
            class="exceptionChartControls"
        >

            <Button
                id="trendChartTypeButton"
                icon="sap-icon://vertical-bar-chart-2"
                type="Default"
                tooltip="Change chart type"
                press="onTrendChartTypeMenuPress"
                class="sapUiTinyMarginBegin"
            />

            <Button
                id="trendExpandButton"
                icon="sap-icon://full-screen"
                type="Default"
                tooltip="Maximize"
                press="onToggleTrendChartSize"
                class="sapUiTinyMarginBegin"
            />

        </HBox>

    </HBox>


    <!-- ===================================================== -->
    <!-- WARNING                                               -->
    <!-- ===================================================== -->

    <MessageStrip
        id="trendWarning"
        text="{trendModel>/warning/message}"
        type="{trendModel>/warning/type}"
        showIcon="true"
        showCloseButton="false"
        visible="{= !!${trendModel>/warning/message} }"
        class="exceptionTrendWarning"
    />


    <!-- ===================================================== -->
    <!-- CHART                                                 -->
    <!-- ===================================================== -->

    <VBox
        id="trendChartContainer"
        width="100%"
        class="exceptionTrendChartContainer"
    >

        <viz:VizFrame
            id="_IDGenVizFrame"
            vizType="column"
            height="250px"
            width="100%"
            xmlns:viz="sap.viz.ui5.controls"
            xmlns:viz.data="sap.viz.ui5.data"
            xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
            renderComplete="onTrendChartRenderComplete"
            vizProperties='{
                "title": {
                    "visible": false
                },
                "legend": {
                    "visible": true,
                    "position": "bottom",
                    "alignment": "center"
                },
                "layout": {
                    "padding": 0
                },
                "plotArea": {
                    "colorPalette": [
                        "#c17b74",
                        "#7a9e6f"
                    ]
                },
                "categoryAxis": {
                    "title": {
                        "visible": false
                    }
                },
                "valueAxis": {
                    "title": {
                        "visible": false
                    }
                }
            }'
        >

            <viz:dataset>

                <viz.data:FlattenedDataset
                   
                    data="{trendModel>/data}"
                >

                    <viz.data:dimensions>

                        <viz.data:DimensionDefinition
                           
                            name="Date"
                            value="{trendModel>dateLabel}"
                        />

                    </viz.data:dimensions>


                    <viz.data:measures>

                        <viz.data:MeasureDefinition
                           
                            name="Opened"
                            value="{trendModel>opened}"
                        />

                        <viz.data:MeasureDefinition
                          
                            name="Resolved"
                            value="{trendModel>resolved}"
                        />

                    </viz.data:measures>

                </viz.data:FlattenedDataset>

            </viz:dataset>


            <viz:feeds>

                <viz.feeds:FeedItem
                  
                    uid="valueAxis"
                    type="Measure"
                    values="Opened,Resolved"
                />

                <viz.feeds:FeedItem
                   
                    uid="categoryAxis"
                    type="Dimension"
                    values="Date"
                />

            </viz:feeds>

        </viz:VizFrame>

    </VBox>




    

</VBox>

         
        <!-- =========================
     BY RAIL
     ========================= -->
<VBox
    id="_IDGenVBox42"
    width="28%"
    class="chartCard sapUiSmallPadding"
    height="420px"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.data="sap.viz.ui5.data"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
>

    <!-- HEADER -->
   <HBox
    id="_IDGenRailHeader"
    alignItems="Center"
    class="exceptionChartHeaderLeft"
>

<HBox
            id="railHeaderIconBox"
            alignItems="Center"
            justifyContent="Center"
            class="exceptionChartHeaderIcon"
        >

            <core:Icon
                id="railHeaderIcon"
                src="sap-icon://shipping-status"
            />

        </HBox>

        <VBox
            id="_IDGenRailTitleBox"
             
        >
            <Title
                id="_IDGenTitle14"
                text="By Rail"
                class="exceptionChartTitle"
            />

            <Text
                id="_IDGenText85"
                text="{railModel>/totalText}"
            
                class="kpiSubText exceptionChartSubtitle"
            />
        </VBox>

       

    </HBox>


    <!-- =========================
         NO DATA
         ========================= -->
    <VBox
        id="_IDGenRailNoData"
        visible="{= ${railModel>/total} === 0 }"
        justifyContent="Center"
        alignItems="Center"
        class="excNoDataWrap"
    >

        <Text
            id="_IDGenRailNoDataText"
            text="No Data"
            class="excNoDataText"
        />

    </VBox>


   
   <!-- ==================================================
     PIE CHART (now DONUT + centered total)
     Visible when railViewModel>/chartType = pie
     ================================================== -->
<VBox
    id="_IDGenRailPieContainer"
    width="100%"
    height="280px"
    class="sapUiSmallMarginTop railPieStack"
    visible="{= ${railModel>/total} > 0 &amp;&amp; ${railViewModel>/chartType} === 'pie' }"
>

    <!-- DONUT + center total overlay -->
    <HBox
        id="_IDGenRailDonutWrapper"
        width="100%"
        class="railPieVisual railDonutWrapper"
    >

        <viz:VizFrame
            id="railPieChart"
            vizType="donut"
            width="170px"
            height="170px"
            vizProperties='{
                "plotArea": {
                    "colorPalette": [
                        "#377dc3",
                        "#e49753",
                        "#ef5f5f"
                    ],
                    "dataLabel": { "visible": false }
                },
                "legend": {
                    "visible": false
                },
                "title": {
                    "visible": false
                },
                "tooltip": {
                    "visible": false
                }
            }'
        >

            <viz:dataset>
                <viz.data:FlattenedDataset
                    id="_IDGenRailFlattenedDataset"
                    data="{railModel>/data}"
                >
                    <viz.data:dimensions>
                        <viz.data:DimensionDefinition
                            id="_IDGenRailDimensionDefinition"
                            name="Status"
                            value="{railModel>status}"
                        />
                    </viz.data:dimensions>
                    <viz.data:measures>
                        <viz.data:MeasureDefinition
                         
                            name="Count"
                            value="{railModel>value}"
                        />
                    </viz.data:measures>
                </viz.data:FlattenedDataset>
            </viz:dataset>

            <viz:feeds>
                <viz.feeds:FeedItem
                    id="_IDGenRailFeedItemSize"
                    uid="size"
                    type="Measure"
                    values="Count"
                />
                <viz.feeds:FeedItem
                    id="_IDGenRailFeedItemColor"
                    uid="color"
                    type="Dimension"
                    values="Status"
                />
            </viz:feeds>

        </viz:VizFrame>

       



        <!-- CENTER TOTAL — sits on top of the donut hole -->
        <VBox
            id="_IDGenRailDonutCenter"
            class="railDonutCenterText"
        >
            <Text
                id="_IDGenRailDonutTotal"
                text="{railModel>/total}"
                class="railDonutValue"
            />
            <Text
                id="_IDGenRailDonutTotalLabel"
                text="total"
                class="railDonutSubLabel"
            />
        </VBox>

    </HBox>


    <!-- LEGEND — dots now match the donut's colorPalette order -->
    <VBox
        id="_IDGenRailLegendBox"
        width="100%"
        class="railPieLegendRow"
    >

        <!-- PENDING -->
        <HBox
            id="_IDGenRailLegendHold"
            justifyContent="SpaceBetween"
            alignItems="Center"
            class="statusItemRow"
        >
            <HBox id="_IDGenRailLegendHoldLabel" alignItems="Center" class="statusLabel">
                <HBox id="_IDGenRailHoldDot" class="railLegendDot railDotPending"/>
                <Text id="_IDGenRailHoldText" text="Pending"/>
            </HBox>
            <Text id="_IDGenRailHoldValue" text="{railModel>/data/0/value}" class="statusValue"/>
        </HBox>

        <!-- IN POST-PROCESSING -->
        <HBox
            id="_IDGenRailLegendPost"
            justifyContent="SpaceBetween"
            alignItems="Center"
            class="statusItemRow"
        >
            <HBox id="_IDGenRailLegendPostLabel" alignItems="Center" class="statusLabel">
                <HBox id="_IDGenRailPostDot" class="railLegendDot railDotPost"/>
                <Text id="_IDGenRailPostText" text="In Post-Processing"/>
            </HBox>
            <Text id="_IDGenRailPostValue" text="{railModel>/data/1/value}" class="statusValue"/>
        </HBox>

        <!-- REJECTED -->
        <HBox
            id="_IDGenRailLegendRejected"
            justifyContent="SpaceBetween"
            alignItems="Center"
            class="statusItemRow"
        >
            <HBox id="_IDGenRailLegendRejectedLabel" alignItems="Center" class="statusLabel">
                <HBox id="_IDGenRailRejectedDot" class="railLegendDot railDotRejected"/>
                <Text id="_IDGenRailRejectedText" text="Rejected"/>
            </HBox>
            <Text id="_IDGenRailRejectedValue" text="{railModel>/data/2/value}" class="statusValue"/>
        </HBox>

    </VBox>

</VBox>




   </VBox>

            <!-- New Tile -->
           <VBox
    id="_IDGenVBox75"
    class="chartCard sapUiSmallPadding"
    width="28%"
    height="420px"
>
    <!-- Header -->
    <HBox
        id="_IDGenHBox45"
        justifyContent="SpaceBetween"
        alignItems="Center"
    >
        <VBox id="_IDGenVBox78">
            <Title
                id="_IDGenTitle16"
                text="Exception Reasons"
                level="H6"
            />
            <Text
                id="_IDGenText117"
                text="Grouped Queue Overview"
                class="kpiSubText"
            />
        </VBox>

        <Button
            id="_IDGenButton"
            text="{= ${reasonModel>/criticalTotal} + ' Critical' }"
            type="Reject"
            class="sapUiTinyMarginBegin"
        />
    </HBox>

    <!-- Info strip — fixed height, wraps instead of clipping -->
    <HBox
        id="_IDGenReasonInfoStrip"
        alignItems="Start"
        visible="{= ${reasonModel>/topReasons}.length > 0 }"
        class="excInfoStripCustom sapUiSmallMarginTop"
    >
        <core:Icon
            id="_IDGenReasonInfoIcon"
            src="sap-icon://message-information"
            class="excInfoStripIcon"
        />
        <Text
            id="_IDGenReasonInfoText"
            text="Top exception drivers requiring action today"
            class="excInfoStripText"
        />
    </HBox>

    <!-- No data -->
    <VBox
        id="_IDGenReasonsNoData"
        visible="{= ${reasonModel>/topReasons}.length === 0 }"
        justifyContent="Center"
        alignItems="Center"
        class="excNoDataWrap"
    >
        <Text
            id="_IDGenReasonsNoDataText"
            text="No Data"
            class="excNoDataText"
        />
    </VBox>

    <!-- Rows -->
   

   <!-- Rows -->
<VBox
    id="_IDGenVBox79"
    class="sapUiMediumMarginTop"
    items="{reasonModel>/topReasons}"
    visible="{= ${reasonModel>/topReasons}.length > 0 }"
>
    <HBox id="_IDGenHBox26" alignItems="Center" class="excReasonRow">

        <Text
            id="_IDGenReasonRank"
            text="{= ${reasonModel>rank} }"
            class="excReasonRankBadge"
        />

        <Text
            id="_IDGenText5"
            text="{reasonModel>reason}"
            class="excReasonName"
        >
            <layoutData>
                <FlexItemData id="_IDGenFlexItemData1" growFactor="1" shrinkFactor="1" baseSize="0%" />
            </layoutData>
        </Text>

        <Text
            id="_IDGenReasonValueText"
            text="{reasonModel>displayValue}"
            class="excReasonValue"
        >
            <layoutData>
                <FlexItemData id="_IDGenFlexItemData3" growFactor="0" shrinkFactor="0" baseSize="32px" />
            </layoutData>
        </Text>

    </HBox>
</VBox>

</VBox>

        </HBox>

        <!-- ✅ Manager Card -->
       
                
          
        <!-- ========================================================= -->
<!-- OPEN EXCEPTIONS WORKSPACE                                -->
<!-- ========================================================= -->

<VBox
    id="_IDGenVBox64"
    class="exceptionWorkspaceCard sapUiMediumMarginTop"
    width="100%"
>

    <!-- ===================================================== -->
    <!-- CARD HEADER                                           -->
    <!-- ===================================================== -->

    <HBox
        id="exceptionWorkspaceHeader"
        width="100%"
        alignItems="Center"
        justifyContent="SpaceBetween"
        class="exceptionWorkspaceHeader"
    >

        <!-- LEFT -->

        <HBox
            id="exceptionWorkspaceHeaderLeft"
            alignItems="Center"
            class="exceptionWorkspaceHeaderLeft"
        >

            <HBox
                id="exceptionWorkspaceIconBox"
                alignItems="Center"
                justifyContent="Center"
                class="exceptionWorkspaceIconBox"
            >

                <core:Icon
                    id="exceptionWorkspaceIcon"
                    src="sap-icon://task"
                />

            </HBox>


            <VBox
                id="exceptionWorkspaceTitleBox"
                class="exceptionWorkspaceTitleBox"
            >

                <Title
                    id="_IDGenTitle15"
                    text="Open Exceptions by Reason"
                    level="H5"
                    class="exceptionWorkspaceTitle"
                />

                <Text
                    id="exceptionWorkspaceSubtitle"
                    text="Review and resolve open payment exceptions"
                    class="exceptionWorkspaceSubtitle"
                />

            </VBox>

        </HBox>


        <!-- RIGHT KPI SUMMARY -->

        <HBox
            id="_IDGenHBox40"
            class="exceptionWorkspaceKpiGroup"
            alignItems="Center"
        >

            <!-- OPEN -->

            <VBox
                id="_IDGenVBox66"
                class="exceptionMiniKpi"
            >

                <Text
                    id="_IDGenText115"
                    text="Open"
                    class="exceptionMiniKpiLabel"
                />

                <Text
                    id="_IDGenText102"
                    text="{openExceptionModel>/total}"
                    class="exceptionMiniKpiValue"
                />

            </VBox>


            <!-- DIVIDER -->

            <VBox
                id="exceptionKpiDivider1"
                class="exceptionMiniKpiDivider"
            />


            <!-- AT RISK -->

            <VBox
                id="_IDGenVBox67"
                class="exceptionMiniKpi"
            >

                <Text
                    id="_IDGenText122"
                    text="Highest Value At Risk"
                    class="exceptionMiniKpiLabel"
                />

                <Text
                    id="_IDGenText123"
                    text="{openExceptionModel>/maxAmount}"
                    class="exceptionMiniKpiValue"
                />

            </VBox>


            <!-- DIVIDER -->

            <VBox
                id="_IDGenVBox76"
                class="exceptionMiniKpiDivider"
            />


            

        </HBox>

    </HBox>





    <!-- ===================================================== -->
    <!-- MANAGER CONTENT                                       -->
    <!-- ===================================================== -->

    <VBox
        id="managerContent"
        class="managerQueueContent"
    >

        <!-- ================================================ -->
        <!-- FILTER AREA                                      -->
        <!-- ================================================ -->

        <VBox
            id="exceptionFilterPanel"
            class="exceptionFilterPanel"
            width="100%"
        >

            <Text
                id="exceptionFilterTitle"
                text="Search exceptions"
                class="exceptionFilterTitle"
            />


            


            <!-- DROPDOWN ROW -->

            <FlexBox
                id="exceptionDropdownFilterRow"
                width="100%"
                wrap="Wrap"
                alignItems="End"
                class="exceptionDropdownFilterRow"
            >

                <!-- RAIL -->

                <VBox
                    id="_IDGenVBox74"
                    class="exceptionFilterItem"
                >

                    <Label
                        id="_IDGenText118"
                        text="Rail"
                        class="exceptionFilterLabel"
                    />

                    <Select
                        id="filterRail"
                        width="100%"
                        change="onFilterChange"
                        class="exceptionFilterSelect"
                    >

                        <core:Item
                            id="_IDGenItem2"
                            key="ALL"
                            text="All"
                        />

                    </Select>

                </VBox>


                <!-- STATUS -->

                <VBox
                    id="_IDGenVBox68"
                    class="exceptionFilterItem"
                >

                    <Label
                        id="_IDGenText119"
                        text="Status"
                        class="exceptionFilterLabel"
                    />

                    <Select
                        id="filterStatus"
                        width="100%"
                        change="onFilterChange"
                        class="exceptionFilterSelect"
                    >

                        <core:Item
                           
                            key="ALL"
                            text="All"
                        />

                        <core:Item
                            
                            key="OPEN"
                            text="Open"
                        />

                        <core:Item
                            
                            key="PROCESSING"
                            text="Processing"
                        />

                        <core:Item
                            
                            key="REJECTED"
                            text="Rejected"
                        />

                    </Select>

                </VBox>


                <!-- AGING -->

                <VBox
                    id="_IDGenVBox69"
                    class="exceptionFilterItem"
                >

                    <Label
                        id="_IDGenText101"
                        text="Aging"
                        class="exceptionFilterLabel"
                    />

                    <Select
                        id="filterAging"
                        width="100%"
                        selectedKey="ALL_AGE"
                        change="onFilterChange"
                        class="exceptionFilterSelect"
                    >

                        <core:Item
                          
                            key="ALL_AGE"
                            text="All Age"
                        />

                    </Select>

                </VBox>

                <!-- CURRENCY -->

                <VBox
                    id="_IDGenVBox72"
                    class="exceptionFilterItem"
                >

                    <Label
                        id="_IDGenText121"
                        text="Currency"
                        class="exceptionFilterLabel"
                    />

                    <Select
                        id="filterCurrency"
                        width="100%"
                        selectedKey="ALL_CURRENCY"
