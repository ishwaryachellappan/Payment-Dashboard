<mvc:View
    controllerName="payment.dashboard.controller.Exceptions"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
<VBox
    id="_IDGenVBox4"
    width="100%"
    class="sapUiTinyMargin">

    <!-- ✅ KPI ROW -->
    <ScrollContainer
        id="_IDGenScrollContainer2"
        horizontal="false"
        vertical="false"
        class="sapUiSmallMarginBottom"
        width="100%"
        height="auto"
    >
        <VBox
            id="_IDGenVBox119"
            class="kpiSectionContainer"
        >
                    <!-- KPI SECTION -->

                 <FlexBox
    id="_IDGenFlexBox"
    wrap="NoWrap"
    fitContainer="true"
    renderType="Bare"
    justifyContent="SpaceBetween"
    alignItems="Stretch"
    width="100%"
    class="kpiSummaryRow">

    <!-- OPEN EXCEPTIONS -->
<VBox id="_IDGenKpiOpenExceptions" class="kpiCard" width="100%" height="100%">
    <HBox id="_IDGenKpiOpenExceptionsTop" class="kpiCardTopRow">
        <Text id="_IDGenKpiOpenExceptionsLabel" text="Open Exceptions" class="kpiCardLabel"/>
        <HBox id="_IDGenKpiOpenExceptionsIconBox" class="kpiIconBox kpiIconRed">
            <core:Icon id="_IDGenKpiOpenExceptionsIcon" src="sap-icon://alert"/>
        </HBox>
    </HBox>
    <Text id="_IDGenKpiOpenExceptionsValue" text="{exceptionKpiModel>/OpenException}" class="kpiCardValue kpiValueRed"/>
    <Text 
        id="_IDGenKpiOpenExceptionsSub" 
        text="{ path: 'exceptionKpiModel>/openExceptionTrend', formatter: '.formatOpenExceptionTrendText' }" 
        class="{ path: 'exceptionKpiModel>/openExceptionTrend', formatter: '.formatOpenExceptionTrendClass' }"
    />
</VBox>

<!-- VALUE AT RISK -->
<VBox id="_IDGenKpiValueAtRisk" class="kpiCard kpiCardNoClick" width="100%" height="100%">
    <HBox id="_IDGenKpiValueAtRiskTop" class="kpiCardTopRow">
        <Text id="_IDGenKpiValueAtRiskLabel" text="Value at Risk" class="kpiCardLabel"/>
        <HBox id="_IDGenKpiValueAtRiskIconBox" class="kpiIconBox kpiIconOrange">
            <core:Icon id="_IDGenKpiValueAtRiskIcon" src="sap-icon://money-bills"/>
        </HBox>
    </HBox>
    <Text 
        id="_IDGenKpiValueAtRiskValue" 
        text="{ path: 'exceptionKpiModel>/ValueAtRisk', formatter: '.formatValueAtRisk' }" 
        class="kpiCardValue kpiValueOrange"
    />
    <Text 
        id="_IDGenKpiValueAtRiskSub" 
        text="{ path: 'exceptionKpiModel>/valueAtRiskTrend', formatter: '.formatValueAtRiskTrendText' }" 
        class="{ path: 'exceptionKpiModel>/valueAtRiskTrend', formatter: '.formatValueAtRiskTrendClass' }"
    />
</VBox>

   <!-- AWAITING APPROVAL -->
<VBox id="_IDGenKpiAwaitingApproval" class="kpiCard kpiCardNoClick" width="100%" height="100%">
    <HBox id="_IDGenKpiAwaitingApprovalTop" class="kpiCardTopRow">
        <Text id="_IDGenKpiAwaitingApprovalLabel" text="Awaiting Approval" class="kpiCardLabel"/>
        <HBox id="_IDGenKpiAwaitingApprovalIconBox" class="kpiIconBox kpiIconPurple">
            <core:Icon id="_IDGenKpiAwaitingApprovalIcon" src="sap-icon://pending"/>
        </HBox>
    </HBox>
    <Text id="_IDGenKpiAwaitingApprovalValue" text="147" class="kpiCardValue kpiValuePurple"/>
    <Text id="_IDGenKpiAwaitingApprovalSub" text="" class="kpiCardSubtext"/>
</VBox>

<!-- SANCTIONS HOLDS -->
<VBox id="_IDGenKpiSanctionsHolds" class="kpiCard kpiCardNoClick" width="100%" height="100%">
    <HBox id="_IDGenKpiSanctionsHoldsTop" class="kpiCardTopRow">
        <Text id="_IDGenKpiSanctionsHoldsLabel" text="Sanctions Holds" class="kpiCardLabel"/>
        <HBox id="_IDGenKpiSanctionsHoldsIconBox" class="kpiIconBox kpiIconDarkRed">
            <core:Icon id="_IDGenKpiSanctionsHoldsIcon" src="sap-icon://shield"/>
        </HBox>
    </HBox>
    <Text id="_IDGenKpiSanctionsHoldsValue" text="38" class="kpiCardValue kpiValueDarkRed"/>
    <Text id="_IDGenKpiSanctionsHoldsSub" text="" class="kpiCardSubtext"/>
</VBox>

</FlexBox>

                </VBox>
            </ScrollContainer>
      

        <!-- // ADD BY Trend CARDS -->

        <HBox
            id="_IDGenHBox43"
            justifyContent="SpaceBetween"
            class="sapUiMediumMarginTop"
        >
            <!-- Trend -->
    
           <VBox
    id="_IDGenVBox37"
    width="40%"
    class="chartCard chartResizable sapUiSmallPadding"
    height="420px"
>
    <HBox
        id="_IDGenTrendHeaderRow"
        justifyContent="SpaceBetween"
        alignItems="Center"
        width="100%"
    >
        <VBox id="_IDGenTrendTitleBox">
            <Title
                id="_IDGenTitle5"
                text="Exception Trend (Last 7 Days)"
            />
            <Text
                id="_IDGenText84"
                text="Opened vs Resolved · Daily Volume"
                class="kpiSubText"
            />
        </VBox>

        <HBox
            id="_IDGenTrendControlsGroup"
            alignItems="Center"
        >
            <Button
                id="trendChartTypeButton"
                icon="sap-icon://vertical-bar-chart-2"
                type="Default"
                tooltip="Change chart type"
                press="onTrendChartTypeMenuPress"
                class="sapUiTinyMarginBegin"
            />

            <Button
                id="trendExpandButton"
                icon="sap-icon://full-screen"
                type="Default"
                tooltip="Maximize"
                press="onToggleTrendChartSize"
                class="chartToolbarButton sapUiTinyMarginBegin"
            />
        </HBox>
    </HBox>


               <MessageStrip
    id="trendWarning"
    text="{trendModel>/warning/message}"
    type="{trendModel>/warning/type}"
    showIcon="true"
    showCloseButton="false"
    visible="{= !!${trendModel>/warning/message} }"
    class="sapUiTinyMarginBottom sapUiTinyMarginBegin"
/>

                <viz:VizFrame
                    id="_IDGenVizFrame"
                    vizType="column"
                    height="260px"
                    width="100%"
                    xmlns:viz="sap.viz.ui5.controls"
                    xmlns:viz.data="sap.viz.ui5.data"
                    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
                    renderComplete="onTrendChartRenderComplete"
                    vizProperties='{
            "title": {        "visible": false     },
           "legend": {        "visible": true,        "position": "bottom"  ,"alignment": "center"  },
           "layout": {        "padding": 0    },
    "plotArea": {
    "colorPalette": ["#c17b74", "#7a9e6f"]   
},
    "categoryAxis": {
        "title": { "visible": false }
    },
    "valueAxis": {
        "title": { "visible": false }
    }
}'
                >
                    <viz:dataset>
                        <viz.data:FlattenedDataset
                            id="_IDGenFlattenedDataset3"
                            data="{trendModel>/data}"
                        >
                            <viz.data:dimensions>
                              <viz.data:DimensionDefinition
    id="_IDGenDimensionDefinition3"
    name="Date"
    value="{trendModel>dateLabel}"
/>
                            </viz.data:dimensions>
                            <viz.data:measures>
                                <viz.data:MeasureDefinition
                                    id="_IDGenMeasureDefinition3"
                                    name="Opened"
                                     value="{trendModel>opened}"
                                />
                                <viz.data:MeasureDefinition
                                    id="_IDGenMeasureDefinition4"
                                    name="Resolved"
                                    value="{trendModel>resolved}"
                                />
                            </viz.data:measures>
                        </viz.data:FlattenedDataset>
                    </viz:dataset>

                    <viz:feeds>
                        <viz.feeds:FeedItem
                            id="_IDGenFeedItem7"
                            uid="valueAxis"
                            type="Measure"
                            values="Opened,Resolved"
                        />
                        <viz.feeds:FeedItem
    id="_IDGenFeedItem8"
    uid="categoryAxis"
    type="Dimension"
    values="Date"
/>
                    </viz:feeds>
                </viz:VizFrame>
            </VBox>

            <!-- By Rail -->
        <!-- =========================
     BY RAIL
     ========================= -->
<VBox
    id="_IDGenVBox42"
    width="28%"
    class="chartCard sapUiSmallPadding"
    height="420px"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.data="sap.viz.ui5.data"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
>

    <!-- HEADER -->
    <HBox
        id="_IDGenRailHeader"
        justifyContent="SpaceBetween"
        alignItems="Center"
        width="100%"
    >

        <VBox
            id="_IDGenRailTitleBox"
        >
            <Title
                id="_IDGenTitle14"
                text="By Rail"
            />

            <Text
                id="_IDGenText85"
                text="{railModel>/totalText}"
                class="kpiSubText"
            />
        </VBox>

       

    </HBox>


    <!-- =========================
         NO DATA
         ========================= -->
    <VBox
        id="_IDGenRailNoData"
        visible="{= ${railModel>/total} === 0 }"
        justifyContent="Center"
        alignItems="Center"
        class="excNoDataWrap"
    >

        <Text
            id="_IDGenRailNoDataText"
            text="No Data"
            class="excNoDataText"
        />

    </VBox>


   
   <!-- ==================================================
     PIE CHART (now DONUT + centered total)
     Visible when railViewModel>/chartType = pie
     ================================================== -->
<VBox
    id="_IDGenRailPieContainer"
    width="100%"
    height="280px"
    class="sapUiSmallMarginTop railPieStack"
    visible="{= ${railModel>/total} > 0 &amp;&amp; ${railViewModel>/chartType} === 'pie' }"
>

    <!-- DONUT + center total overlay -->
    <HBox
        id="_IDGenRailDonutWrapper"
        width="100%"
        class="railPieVisual railDonutWrapper"
    >

        <viz:VizFrame
            id="railPieChart"
            vizType="donut"
            width="170px"
            height="170px"
            vizProperties='{
                "plotArea": {
                    "colorPalette": [
                        "#377dc3",
                        "#e49753",
                        "#ef5f5f"
                    ],
                    "dataLabel": { "visible": false }
                },
                "legend": {
                    "visible": false
                },
                "title": {
                    "visible": false
                },
                "tooltip": {
                    "visible": true
                }
            }'
        >

            <viz:dataset>
                <viz.data:FlattenedDataset
                    id="_IDGenRailFlattenedDataset"
                    data="{railModel>/data}"
                >
                    <viz.data:dimensions>
                        <viz.data:DimensionDefinition
                            id="_IDGenRailDimensionDefinition"
                            name="Status"
                            value="{railModel>status}"
                        />
                    </viz.data:dimensions>
                    <viz.data:measures>
                        <viz.data:MeasureDefinition
                            id="_IDGenRailMeasureDefinition"
                            name="Count"
                            value="{railModel>value}"
                        />
                    </viz.data:measures>
                </viz.data:FlattenedDataset>
            </viz:dataset>

            <viz:feeds>
                <viz.feeds:FeedItem
                    id="_IDGenRailFeedItemSize"
                    uid="size"
                    type="Measure"
                    values="Count"
                />
                <viz.feeds:FeedItem
                    id="_IDGenRailFeedItemColor"
                    uid="color"
                    type="Dimension"
                    values="Status"
                />
            </viz:feeds>

        </viz:VizFrame>

        <!-- CENTER TOTAL — sits on top of the donut hole -->
        <VBox
            id="_IDGenRailDonutCenter"
            class="railDonutCenterText"
        >
            <Text
                id="_IDGenRailDonutTotal"
                text="{railModel>/total}"
                class="railDonutValue"
            />
            <Text
                id="_IDGenRailDonutTotalLabel"
                text="total"
                class="railDonutSubLabel"
            />
        </VBox>

    </HBox>


    <!-- LEGEND — dots now match the donut's colorPalette order -->
    <VBox
        id="_IDGenRailLegendBox"
        width="100%"
        class="railPieLegendRow"
    >

        <!-- PENDING -->
        <HBox
            id="_IDGenRailLegendHold"
            justifyContent="SpaceBetween"
            alignItems="Center"
            class="statusItemRow"
        >
            <HBox id="_IDGenRailLegendHoldLabel" alignItems="Center" class="statusLabel">
                <HBox id="_IDGenRailHoldDot" class="railLegendDot railDotPending"/>
                <Text id="_IDGenRailHoldText" text="Pending"/>
            </HBox>
            <Text id="_IDGenRailHoldValue" text="{railModel>/data/0/value}" class="statusValue"/>
        </HBox>

        <!-- IN POST-PROCESSING -->
        <HBox
            id="_IDGenRailLegendPost"
            justifyContent="SpaceBetween"
            alignItems="Center"
            class="statusItemRow"
        >
            <HBox id="_IDGenRailLegendPostLabel" alignItems="Center" class="statusLabel">
                <HBox id="_IDGenRailPostDot" class="railLegendDot railDotPost"/>
                <Text id="_IDGenRailPostText" text="In Post-Processing"/>
            </HBox>
            <Text id="_IDGenRailPostValue" text="{railModel>/data/1/value}" class="statusValue"/>
        </HBox>

        <!-- REJECTED -->
        <HBox
            id="_IDGenRailLegendRejected"
            justifyContent="SpaceBetween"
            alignItems="Center"
            class="statusItemRow"
        >
            <HBox id="_IDGenRailLegendRejectedLabel" alignItems="Center" class="statusLabel">
                <HBox id="_IDGenRailRejectedDot" class="railLegendDot railDotRejected"/>
                <Text id="_IDGenRailRejectedText" text="Rejected"/>
            </HBox>
            <Text id="_IDGenRailRejectedValue" text="{railModel>/data/2/value}" class="statusValue"/>
        </HBox>

    </VBox>

</VBox>




   </VBox>

            <!-- New Tile -->
           <VBox
    id="_IDGenVBox75"
    class="chartCard sapUiSmallPadding"
    width="28%"
    height="420px"
>
    <!-- Header -->
    <HBox
        id="_IDGenHBox45"
        justifyContent="SpaceBetween"
        alignItems="Center"
    >
        <VBox id="_IDGenVBox78">
            <Title
                id="_IDGenTitle16"
                text="Exception Reasons"
                level="H6"
            />
            <Text
                id="_IDGenText117"
                text="Grouped Queue Overview"
                class="kpiSubText"
            />
        </VBox>

        <Button
            id="_IDGenButton"
            text="{= ${reasonModel>/criticalTotal} + ' Critical' }"
            type="Reject"
            class="sapUiTinyMarginBegin"
        />
    </HBox>

    <!-- Info strip — fixed height, wraps instead of clipping -->
    <HBox
        id="_IDGenReasonInfoStrip"
        alignItems="Start"
        visible="{= ${reasonModel>/topReasons}.length > 0 }"
        class="excInfoStripCustom sapUiSmallMarginTop"
    >
        <core:Icon
            id="_IDGenReasonInfoIcon"
            src="sap-icon://message-information"
            class="excInfoStripIcon"
        />
        <Text
            id="_IDGenReasonInfoText"
            text="Top exception drivers requiring action today"
            class="excInfoStripText"
        />
    </HBox>

    <!-- No data -->
    <VBox
        id="_IDGenReasonsNoData"
        visible="{= ${reasonModel>/topReasons}.length === 0 }"
        justifyContent="Center"
        alignItems="Center"
        class="excNoDataWrap"
    >
        <Text
            id="_IDGenReasonsNoDataText"
            text="No Data"
            class="excNoDataText"
        />
    </VBox>

    <!-- Rows -->
   

   <!-- Rows -->
<VBox
    id="_IDGenVBox79"
    class="sapUiMediumMarginTop"
    items="{reasonModel>/topReasons}"
    visible="{= ${reasonModel>/topReasons}.length > 0 }"
>
    <HBox id="_IDGenHBox26" alignItems="Center" class="excReasonRow">

        <Text
            id="_IDGenReasonRank"
            text="{= ${reasonModel>rank} }"
            class="excReasonRankBadge"
        />

        <Text
            id="_IDGenText5"
            text="{reasonModel>reason}"
            class="excReasonName"
        >
            <layoutData>
                <FlexItemData id="_IDGenFlexItemData1" growFactor="1" shrinkFactor="1" baseSize="0%" />
            </layoutData>
        </Text>

        <Text
            id="_IDGenReasonValueText"
            text="{reasonModel>displayValue}"
            class="excReasonValue"
        >
            <layoutData>
                <FlexItemData id="_IDGenFlexItemData3" growFactor="0" shrinkFactor="0" baseSize="32px" />
            </layoutData>
        </Text>

    </HBox>
</VBox>

</VBox>

        </HBox>

        <!-- ✅ Manager Card -->
        <VBox
            id="_IDGenVBox64"
            class="chartCard sapUiSmallPadding sapUiMediumMarginTop"
        >
            <!-- ✅ TOP TEXT -->
            <VBox
                id="_IDGenVBox72"
                class="sapUiSmallMarginBottom"
            >
                <Title
                    id="_IDGenTitle15"
                    text="Open Exceptions by Reason"
                    level="H6"
                />

         

                <!-- ✅ RIGHT (ALL INLINE ✅) -->
                    <HBox
                        id="_IDGenHBox40"
                        class="kpiGroup"
                    >
                        <!-- OPEN -->
                        <VBox
                            id="_IDGenVBox66"
                            class="kpiBlock kpiOpenShift "
                        >
                            <Text
                                id="_IDGenText115"
                                text="Open"
                                class="kpiSubText"
                            />
                            <Text
                                id="_IDGenText102"
                               text="{openExceptionModel>/total}"
                                class="kpiBigText"
                            />
                        </VBox>

                        <!-- AT RISK -->
                        <VBox
                            id="_IDGenVBox67"
                            class="kpiBlock sapUiTinyMarginEnd"
                        >
                            <Text
    id="_IDGenText122"
    text="At Risk"
    class="kpiSubText"
/>

<Text
    id="_IDGenText123"
    text="{openExceptionModel>/maxAmount}"
    class="kpiBigText"
/>
                        </VBox>

                        <!-- DIVIDER -->
                        <VBox
                            id="_IDGenVBox76"
                            class="verticalDivider sapUiTinyMarginBegin sapUiTinyMarginEnd"
                        />

                        <!-- MAX -->
                        <Button
                            id="_IDGenButton3"
                          text="{= 'Max ' + ${openExceptionModel>/maxAge}}"
                            type="Transparent"
                            class="maxAgeButton sapUiTinyMarginEnd"
                        />

                       
                    </HBox>

            </VBox>



            <!-- ✅ CLICKABLE HEADER -->
            <Button
                type="Transparent"
                press="onToggleManager"
                icon="sap-icon://slim-arrow-down"
                text="Manager - Daily Startup"
                iconFirst="true"
                id="managerHeader"
                class="managerHeader"
            />

            <!-- ✅ WRAP EVERYTHING BELOW (CRITICAL ✅) -->
            <VBox id="managerContent">
                <!-- ✅ FILTER ROW -->
                <HBox
                    id="_IDGenHBox38"
                    wrap="Wrap"
                    class="sapUiSmallMarginTop"
                    justifyContent="SpaceBetween"
                >
                    <!-- SEARCH -->
                    <VBox id="_IDGenVBox73">
                        <Text
                            id="_IDGenText98"
                            text="Search"
                        />
                        <SearchField
                            id="_IDGenSearchField1"
                            width="260px"
                            placeholder="Search for Customer, Ref., IBAN, BIC..."
                            liveChange="onGlobalSearch"
                        />
                    </VBox>

                    <!-- RAIL -->
                    <VBox id="_IDGenVBox74">
                        <Text
                            id="_IDGenText118"
                            text="Rail"
                        />
                        <Select
                            id="filterRail"
                            change="onFilterChange"
                        >
                            <core:Item
                                id="_IDGenItem2"
                                key="ALL"
                                text="All"
                            />
                           
                        </Select>
                    </VBox>

                    <!-- STATUS -->
                    <VBox id="_IDGenVBox68">
                        <Text
                            id="_IDGenText119"
                            text="Status"
                        />
                        <Select
                            id="filterStatus"
                            change="onFilterChange"
                        >
                            <core:Item
                                id="_IDGenItem6"
                                key="ALL"
                                text="All"
                            />
                            <core:Item
                                id="_IDGenItem7"
                                key="OPEN"
                                text="Open"
                            />
                            <core:Item
                                id="_IDGenItem8"
                                key="PROCESSING"
                                text="Processing"
                            />
                            <core:Item
                                id="_IDGenItem9"
                                key="REJECTED"
                                text="Rejected"
                            />
                        </Select>
                    </VBox>

                    <!-- AGING -->
                    <VBox id="_IDGenVBox69">
                        <Text
                            id="_IDGenText101"
                            text="Aging"
                        />
                        <Select
                            id="filterAging"
                            selectedKey="ALL_AGE"
                            change="onFilterChange"
                        >
                            <core:Item
                                id="_IDGenItem"
                                key="ALL_AGE"
                                text="All Age"
                            />
                        </Select>
                    </VBox>

                    <!-- SEGMENT -->
                   <VBox id="_IDGenVBox70">
    <Text
        id="_IDGenText120"
        text="Object Category"
    />

    <Select
        id="filterObjectCategory"
        width="160px"
        selectedKey="ALL_OBJECT_CATEGORY"
        change="onFilterChange"
    >
        <core:Item id="_IDGenItem1"
            key="ALL_OBJECT_CATEGORY"
            text="All"
        />
    </Select>
</VBox>

                    <!-- REASON -->
                    <VBox id="_IDGenVBox71">
                        <Text
                            id="_IDGenText104"
                            text="Reason Contains"
                        />
                        <Input
                            id="_IDGenInput"
                            width="220px"
                            placeholder="E.g: Sanctions, IBAN"
                            liveChange="onFilterChange"
                        />
                    </VBox>
                </HBox>

                <!-- ✅ DIVIDER -->
                <HBox
                    id="_IDGenHBox41"
                    class="horizontalDivider sapUiTinyMarginTop sapUiTinyMarginBottom"
                />

               

                <!-- SANCTIONS TABLE -->

 <VBox
    id="_IDGenVBox80"
    width="100%"
    class="sapUiMediumMarginTop excTableOuter"
>
    <ScrollContainer
        id="exceptionTableScroll"
        width="100%"
        height="440px"
        vertical="true"
        horizontal="true"
        class="excTableScrollContainer"
    >
        <Table
            id="_IDGenTable3"
            items="{openExceptionModel>/data}"
            mode="MultiSelect"
            includeItemInSelection="true"
            showNoData="false"
            fixedLayout="true"
            width="100%"
        >
            <columns>
                <Column id="colClearingArea" width="110px"><Text id="_IDGenText55" text="Clearing Area"/></Column>
                <Column id="colPaymentItemDate" width="130px"><Text id="_IDGenText56" text="Payment Item Date"/></Column>
                <Column id="colObjectCategory" width="120px"><Text id="_IDGenText58" text="Object Category"/></Column>
                <Column id="_IDGenColumn17" width="100px"><Text id="_IDGenText6" text="PO type"/></Column>
                <Column id="_IDGenColumn18" width="120px"><Text id="_IDGenText27" text="Po Type Status"/></Column>
                <Column id="colTechStat" width="140px"><Text id="_IDGenText59" text="Technical Status"/></Column>
                <Column id="colPaymentItemNumber" width="150px"><Text id="_IDGenText86" text="Payment Item Number"/></Column>
                <Column id="colReference" width="120px"><Text id="_IDGenText87" text="Reference"/></Column>
                <Column id="colReasonDetail" width="180px"><Text id="_IDGenText88" text="Reason Detail"/></Column>
                <Column id="colAmount" width="110px" hAlign="End"><Text id="_IDGenText89" text="Amount"/></Column>
                <Column id="colCurrency" width="90px"><Text id="_IDGenText90" text="Currency"/></Column>
                <Column id="colAged" width="90px"><Text id="_IDGenText91" text="Aged"/></Column>
                <Column id="colCounterParty" width="150px"><Text id="_IDGenText92" text="Counterparty"/></Column>
            </columns>

            <items>
                <ColumnListItem id="openExceptionRow">
                    <cells>
                        <Text id="_IDGenText93" text="{openExceptionModel>ClearingArea}"/>
                        <Text id="_IDGenText94" text="{openExceptionModel>PaymentItemDate}"/>
                        <Text id="_IDGenText96" text="{openExceptionModel>ObjectCategory}"/>
                        <Text id="_IDGenText54" text="{openExceptionModel>po_type}"/>
                        <Text id="_IDGenText57" text="{openExceptionModel>po_typet_s}"/>
                        <Text id="_IDGenText105" text="{openExceptionModel>Status}"/>
                        <Text id="_IDGenText106" text="{openExceptionModel>PaymentItemNumber}"/>
                        <Text id="_IDGenText107" text="{openExceptionModel>Reference}"/>
                        <Text id="_IDGenText108" text="{openExceptionModel>ReasonDetail}"/>
                        <Text id="_IDGenText109" text="{openExceptionModel>Amount}"/>
                        <Text id="_IDGenText110" text="{openExceptionModel>CURRENCY}"/>
