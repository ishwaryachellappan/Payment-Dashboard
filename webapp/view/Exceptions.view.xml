<mvc:View
    controllerName="payment.dashboard.controller.Exceptions"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <VBox
        id="_IDGenVBox4"
        class="sapUiMediumMargin"
    >
        <VBox
            id="_IDGenVBox40"
            class="sapUiSmallMargin"
        >
            <!-- ✅ KPI ROW -->
            <ScrollContainer
                id="_IDGenScrollContainer2"
                horizontal="false"
                vertical="false"
                class="sapUiSmallMarginBottom"
                width="100%"
                height="auto"
            >
                <VBox
                    id="_IDGenVBox119"
                    class="kpiSectionContainer"
                >
                    <!-- KPI SECTION -->

                    <FlexBox
    id="_IDGenFlexBox"
    wrap="NoWrap"
    fitContainer="true"
    renderType="Bare"
    justifyContent="SpaceBetween"
    alignItems="Stretch"
    width="100%"
    class="kpiSummaryRow">
    
                        <GenericTile
                            id="_IDGenGenericTile8"
                            header="Open Exceptions"
                            class="sapUiTinyMargin kpiTile"
                            press="onOpenExceptionsPress"
                        >
                            <TileContent id="_IDGenTileContent4">
                                <VBox id="_IDGenVBox44">
                                    <!-- ✅ MAIN NUMBER -->
                                    <NumericContent
                                        id="_IDGenNumericContent4"
                                        value="{exceptionKpiModel>/OpenException}"
                                        valueColor="Error"
                                    />
                                </VBox>
                            </TileContent>
                        </GenericTile>

                        <GenericTile
                            id="_IDGenGenericTile5"
                            header="Value at Risk"
                            class="sapUiTinyMargin kpiTile kpiTileNoClick"
                        >
                            <TileContent id="_IDGenTileContent5">
                                <VBox id="_IDGenVBox43">
                                    <NumericContent
                                        id="_IDGenNumericContent5"
                                        value="{exceptionKpiModel>/ValueAtRisk}"
                                        valueColor="Critical"
                                    />
                                </VBox>
                            </TileContent>
                        </GenericTile>

                        

                        <GenericTile
                            id="_IDGenGenericTile7"
                            header="Awaiting Approval"
                            class="sapUiTinyMargin kpiTile"
                        >
                            <TileContent id="_IDGenTileContent7">
                                <VBox id="_IDGenVBox47">
                                    <NumericContent
                                        id="_IDGenNumericContent7"
                                        value="147"
                                        valueColor="Critical"
                                    />
                                </VBox>
                            </TileContent>
                        </GenericTile>

                        <GenericTile
                            id="_IDGenGenericTile9"
                            header="Sancation Holds"
                            class="sapUiTinyMargin kpiTile"
                        >
                            <TileContent id="_IDGenTileContent8">
                                <VBox id="_IDGenVBox41">
                                    <NumericContent
                                        id="_IDGenNumericContent8"
                                        value="38"
                                        valueColor="Critical"
                                    />
                                </VBox>
                            </TileContent>
                        </GenericTile>
                    </FlexBox>
                </VBox>
            </ScrollContainer>
        </VBox>

        <!-- // ADD BY Trend CARDS -->

        <HBox
            id="_IDGenHBox43"
            justifyContent="SpaceBetween"
            class="sapUiMediumMarginTop"
        >
            <!-- Trend -->
    
           <VBox
    id="_IDGenVBox37"
    width="40%"
    class="chartCard chartResizable sapUiSmallPadding"
    height="420px"
>
    <HBox
        id="_IDGenTrendHeaderRow"
        justifyContent="SpaceBetween"
        alignItems="Center"
        width="100%"
    >
        <VBox id="_IDGenTrendTitleBox">
            <Title
                id="_IDGenTitle5"
                text="Exception Trend (Last 7 Days)"
            />
            <Text
                id="_IDGenText84"
                text="Opened vs Resolved · Daily Volume"
                class="kpiSubText"
            />
        </VBox>

        <HBox
            id="_IDGenTrendControlsGroup"
            alignItems="Center"
        >
            <Button
                id="trendChartTypeButton"
                icon="sap-icon://vertical-bar-chart-2"
                type="Default"
                tooltip="Change chart type"
                press="onTrendChartTypeMenuPress"
                class="sapUiTinyMarginBegin"
            />

            <Button
                id="trendExpandButton"
                icon="sap-icon://full-screen"
                type="Default"
                tooltip="Maximize"
                press="onToggleTrendChartSize"
                class="chartToolbarButton sapUiTinyMarginBegin"
            />
        </HBox>
    </HBox>


               <MessageStrip
    id="trendWarning"
    text="{trendModel>/warning/message}"
    type="{trendModel>/warning/type}"
    showIcon="true"
    showCloseButton="false"
    visible="{= !!${trendModel>/warning/message} }"
    class="sapUiTinyMarginBottom sapUiTinyMarginBegin"
/>

                <viz:VizFrame
                    id="_IDGenVizFrame"
                    vizType="column"
                    height="260px"
                    width="100%"
                    xmlns:viz="sap.viz.ui5.controls"
                    xmlns:viz.data="sap.viz.ui5.data"
                    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
                    renderComplete="onTrendChartRenderComplete"
                    vizProperties='{
            "title": {        "visible": false     },
           "legend": {        "visible": true,        "position": "bottom"  ,"alignment": "center"  },
           "layout": {        "padding": 0    },
    "plotArea": {
        "colorPalette": ["#e53935", "#43a047"]   
    },
    "categoryAxis": {
        "title": { "visible": false }
    },
    "valueAxis": {
        "title": { "visible": false }
    }
}'
                >
                    <viz:dataset>
                        <viz.data:FlattenedDataset
                            id="_IDGenFlattenedDataset3"
                            data="{trendModel>/data}"
                        >
                            <viz.data:dimensions>
                              <viz.data:DimensionDefinition
    id="_IDGenDimensionDefinition3"
    name="Date"
    value="{trendModel>dateLabel}"
/>
                            </viz.data:dimensions>
                            <viz.data:measures>
                                <viz.data:MeasureDefinition
                                    id="_IDGenMeasureDefinition3"
                                    name="Opened"
                                     value="{trendModel>opened}"
                                />
                                <viz.data:MeasureDefinition
                                    id="_IDGenMeasureDefinition4"
                                    name="Resolved"
                                    value="{trendModel>resolved}"
                                />
                            </viz.data:measures>
                        </viz.data:FlattenedDataset>
                    </viz:dataset>

                    <viz:feeds>
                        <viz.feeds:FeedItem
                            id="_IDGenFeedItem7"
                            uid="valueAxis"
                            type="Measure"
                            values="Opened,Resolved"
                        />
                        <viz.feeds:FeedItem
    id="_IDGenFeedItem8"
    uid="categoryAxis"
    type="Dimension"
    values="Date"
/>
                    </viz:feeds>
                </viz:VizFrame>
            </VBox>

            <!-- By Rail -->
        <!-- =========================
     BY RAIL
     ========================= -->
<VBox
    id="_IDGenVBox42"
    width="28%"
    class="chartCard sapUiSmallPadding"
    height="420px"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.data="sap.viz.ui5.data"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
>

    <!-- HEADER -->
    <HBox
        id="_IDGenRailHeader"
        justifyContent="SpaceBetween"
        alignItems="Center"
        width="100%"
    >

        <VBox
            id="_IDGenRailTitleBox"
        >
            <Title
                id="_IDGenTitle14"
                text="By Rail"
            />

            <Text
                id="_IDGenText85"
                text="{railModel>/totalText}"
                class="kpiSubText"
            />
        </VBox>

        <!-- TOGGLE BUTTON -->
        <Button
            id="railChartTypeButton"
            icon="sap-icon://horizontal-bar-chart-2"
            type="Default"
            tooltip="Show Progress Bar"
            press="onToggleRailChartType"
        />

    </HBox>


    <!-- =========================
         NO DATA
         ========================= -->
    <VBox
        id="_IDGenRailNoData"
        visible="{= ${railModel>/total} === 0 }"
        justifyContent="Center"
        alignItems="Center"
        class="excNoDataWrap"
    >

        <Text
            id="_IDGenRailNoDataText"
            text="No Data"
            class="excNoDataText"
        />

    </VBox>


    <!-- ==================================================
         PIE CHART
         Visible when railViewModel>/chartType = pie
         ================================================== -->
    <HBox
        id="_IDGenRailPieContainer"
        alignItems="Center"
        justifyContent="Center"
        width="100%"
        height="260px"
        class="sapUiSmallMarginTop"
        visible="{= ${railModel>/total} > 0 &amp;&amp; ${railViewModel>/chartType} === 'pie' }"
    >

        <!-- PIE -->
        <VBox
            id="_IDGenRailDonutWrapper"
            width="55%"
            height="220px"
            justifyContent="Center"
            alignItems="Center"
            class="donutWrapper"
        >

            <viz:VizFrame
                id="railPieChart"
                vizType="pie"
                width="190px"
                height="190px"
                vizProperties='{
                    "plotArea": {
                        "colorPalette": [
                            "#1976d2",
                            "#fb8c00",
                            "#d32f2f"
                        ]
                    },
                    "legend": {
                        "visible": false
                    },
                    "title": {
                        "visible": false
                    },
                    "tooltip": {
                        "visible": true
                    }
                }'
            >

                <viz:dataset>

                    <viz.data:FlattenedDataset
                        id="_IDGenRailFlattenedDataset"
                        data="{railModel>/data}"
                    >

                        <viz.data:dimensions>

                            <viz.data:DimensionDefinition
                                id="_IDGenRailDimensionDefinition"
                                name="Status"
                                value="{railModel>status}"
                            />

                        </viz.data:dimensions>

                        <viz.data:measures>

                            <viz.data:MeasureDefinition
                                id="_IDGenRailMeasureDefinition"
                                name="Count"
                                value="{railModel>value}"
                            />

                        </viz.data:measures>

                    </viz.data:FlattenedDataset>

                </viz:dataset>


                <viz:feeds>

                    <viz.feeds:FeedItem
                        id="_IDGenRailFeedItemSize"
                        uid="size"
                        type="Measure"
                        values="Count"
                    />

                    <viz.feeds:FeedItem
                        id="_IDGenRailFeedItemColor"
                        uid="color"
                        type="Dimension"
                        values="Status"
                    />

                </viz:feeds>

            </viz:VizFrame>

        </VBox>


        <!-- PIE LEGEND -->
        <VBox
            id="_IDGenRailLegendBox"
            width="45%"
            class="sapUiSmallMarginBegin"
        >

            <!-- ON HOLD -->
            <HBox
                id="_IDGenRailLegendHold"
                justifyContent="SpaceBetween"
                alignItems="Center"
                class="statusItemRow"
            >

                <HBox
                    id="_IDGenRailLegendHoldLabel"
                    alignItems="Center"
                    class="statusLabel"
                >

                    <core:Icon
                        id="_IDGenRailHoldIcon"
                        src="sap-icon://status-inactive"
                        class="statusBlue"
                        size="1rem"
                    />

                    <Text
                        id="_IDGenRailHoldText"
                        text="Pending"
                    />

                </HBox>

                <Text
                    id="_IDGenRailHoldValue"
                    text="{railModel>/data/0/value}"
                    class="statusValue"
                />

            </HBox>


            <!-- POST PROCESSING -->
            <HBox
                id="_IDGenRailLegendPost"
                justifyContent="SpaceBetween"
                alignItems="Center"
                class="statusItemRow"
            >

                <HBox
                    id="_IDGenRailLegendPostLabel"
                    alignItems="Center"
                    class="statusLabel"
                >

                    <core:Icon
                        id="_IDGenRailPostIcon"
                        src="sap-icon://alert"
                        class="statusOrange"
                        size="1rem"
                    />

                    <Text
                        id="_IDGenRailPostText"
                        text="In Post-Processing"
                    />

                </HBox>

                <Text
                    id="_IDGenRailPostValue"
                    text="{railModel>/data/1/value}"
                    class="statusValue"
                />

            </HBox>


            <!-- REJECTED -->
            <HBox
                id="_IDGenRailLegendRejected"
                justifyContent="SpaceBetween"
                alignItems="Center"
                class="statusItemRow"
            >

                <HBox
                    id="_IDGenRailLegendRejectedLabel"
                    alignItems="Center"
                    class="statusLabel"
                >

                    <core:Icon
                        id="_IDGenRailRejectedIcon"
                        src="sap-icon://status-negative"
                        class="statusRed"
                        size="1rem"
                    />

                    <Text
                        id="_IDGenRailRejectedText"
                        text="Rejected"
                    />

                </HBox>

                <Text
                    id="_IDGenRailRejectedValue"
                    text="{railModel>/data/2/value}"
                    class="statusValue"
                />

            </HBox>

        </VBox>

    </HBox>


    <!-- ==================================================
         PROGRESS BAR VIEW
         Visible when railViewModel>/chartType = progress
         ================================================== -->
    <VBox
        id="_IDGenRailProgressContainer"
        width="100%"
        class="sapUiMediumMarginTop"
        visible="{= ${railModel>/total} > 0 &amp;&amp; ${railViewModel>/chartType} === 'progress' }"
    >

        <!-- ON HOLD -->
        <VBox
            id="_IDGenRailProgressHold"
            class="sapUiSmallMarginBottom"
        >

            <HBox id="_IDGenHBox28"
                justifyContent="SpaceBetween"
                alignItems="Center"
            >

                <Text id="_IDGenText1"
                    text="Pending"
                    class="statusLabel"
                />

               

            </HBox>

           <ProgressIndicator
    id="_IDGenRailProgressIndicatorHold"
    percentValue="{railModel>/data/0/percent}"
    displayValue="{railModel>/data/0/value}"
    width="100%"
/>

        </VBox>


        <!-- POST PROCESSING -->
        <VBox
            id="_IDGenRailProgressPost"
            class="sapUiSmallMarginBottom"
        >

            <HBox id="_IDGenHBox29"
                justifyContent="SpaceBetween"
                alignItems="Center"
            >

                <Text id="_IDGenText21"
                    text="In Post-Processing"
                    class="statusLabel"
                />

             

            </HBox>

            <ProgressIndicator
    id="_IDGenRailProgressIndicatorPost"
    percentValue="{railModel>/data/1/percent}"
    displayValue="{railModel>/data/1/value}"
    width="100%"
/>

        </VBox>


        <!-- REJECTED -->
        <VBox
            id="_IDGenRailProgressRejected"
            class="sapUiSmallMarginBottom"
        >

            <HBox id="_IDGenHBox30"
                justifyContent="SpaceBetween"
                alignItems="Center"
            >

                <Text id="_IDGenText36"
                    text="Rejected"
                    class="statusLabel"
                />

               

            </HBox>

            <ProgressIndicator
    id="_IDGenRailProgressIndicatorRejected"
    percentValue="{railModel>/data/2/percent}"
    displayValue="{railModel>/data/2/value}"
    width="100%"
/>

        </VBox>

    </VBox>

</VBox>

            <!-- New Tile -->
            <VBox
                id="_IDGenVBox75"
                class="chartCard sapUiSmallPadding"
                width="28%"
                height="420px"
            >
                <!-- Header -->
                <HBox
                    id="_IDGenHBox45"
                    justifyContent="SpaceBetween"
                    alignItems="Center"
                >
                    <VBox id="_IDGenVBox78">
                        <Title
                            id="_IDGenTitle16"
                            text="Exception Reasons"
                            level="H6"
                        />
                        <Text
                            id="_IDGenText117"
                            text="Grouped Queue Overview"
                            class="kpiSubText"
                        />
                    </VBox>

                    <Button
                        id="_IDGenButton"
                          text="{= ${reasonModel>/criticalTotal} + ' Critical' }"
                        type="Reject"
                        class="sapUiTinyMarginBegin"
                    />
                </HBox>

             
                <!-- Info Strip - only shown when there IS data -->
<MessageStrip
    id="_IDGenMessageStrip2"
    text="Top exception drivers requiring action today"
    type="Information"
    showCloseButton="false"
    showIcon="true"
    visible="{= ${reasonModel>/topReasons}.length > 0 }"
    class="excInfoStrip sapUiSmallMarginTop"
/>

<!-- ✅ NO DATA state — centered message, no info strip on top -->
<VBox
    id="_IDGenReasonsNoData"
    visible="{= ${reasonModel>/topReasons}.length === 0 }"
    justifyContent="Center"
    alignItems="Center"
    class="excNoDataWrap"
>
    <Text
        id="_IDGenReasonsNoDataText"
        text="No Data"
        class="excNoDataText"
    />
</VBox>

                <!-- Chart -->
                <!-- ✅ Was 5 hardcoded rows — now one template row repeated per
                     entry in reasonModel>/topReasons (set by
                     Exceptions.controller.js#loadExceptionReasons). -->
               <VBox
    id="_IDGenVBox79"
    class="sapUiMediumMarginTop"
    items="{reasonModel>/topReasons}"
    visible="{= ${reasonModel>/topReasons}.length > 0 }"
>
                   <HBox id="_IDGenHBox26"
    alignItems="Center"
    class="excReasonRow"
>
    <Text id="_IDGenText5"
        text="{reasonModel>reason}"
        class="excReasonName"
    >
        <layoutData>
            <FlexItemData id="_IDGenFlexItemData1" growFactor="0" shrinkFactor="0" baseSize="40%" />
        </layoutData>
    </Text>

    <ProgressIndicator
        id="_IDGenReasonProgress"
        percentValue="{reasonModel>percent}"
        displayValue="{reasonModel>displayValue}"
      
        width="100%"
        class="excProgressBar excProgressBarConstant"
    >
        <layoutData>
            <FlexItemData id="_IDGenFlexItemData2" growFactor="1" shrinkFactor="1" baseSize="0%" />
        </layoutData>
    </ProgressIndicator>
</HBox>
                </VBox>
            </VBox>
        </HBox>

        <!-- ✅ Manager Card -->
        <VBox
            id="_IDGenVBox64"
            class="chartCard sapUiSmallPadding sapUiMediumMarginTop"
        >
            <!-- ✅ TOP TEXT -->
            <VBox
                id="_IDGenVBox72"
                class="sapUiSmallMarginBottom"
            >
                <Title
                    id="_IDGenTitle15"
                    text="Open Exceptions by Reason"
                    level="H6"
                />

         

                <!-- ✅ RIGHT (ALL INLINE ✅) -->
                    <HBox
                        id="_IDGenHBox40"
                        class="kpiGroup"
                    >
                        <!-- OPEN -->
                        <VBox
                            id="_IDGenVBox66"
                            class="kpiBlock kpiOpenShift "
                        >
                            <Text
                                id="_IDGenText115"
                                text="Open"
                                class="kpiSubText"
                            />
                            <Text
                                id="_IDGenText102"
                               text="{openExceptionModel>/total}"
                                class="kpiBigText"
                            />
                        </VBox>

                        <!-- AT RISK -->
                        <VBox
                            id="_IDGenVBox67"
                            class="kpiBlock sapUiTinyMarginEnd"
                        >
                            <Text
    id="_IDGenText122"
    text="At Risk"
    class="kpiSubText"
/>

<Text
    id="_IDGenText123"
    text="{openExceptionModel>/maxAmount}"
    class="kpiBigText"
/>
                        </VBox>

                        <!-- DIVIDER -->
                        <VBox
                            id="_IDGenVBox76"
                            class="verticalDivider sapUiTinyMarginBegin sapUiTinyMarginEnd"
                        />

                        <!-- MAX -->
                        <Button
                            id="_IDGenButton3"
                          text="{= 'Max ' + ${openExceptionModel>/maxAge}}"
                            type="Transparent"
                            class="maxAgeButton sapUiTinyMarginEnd"
                        />

                        <!-- INVESTIGATE -->
                        <Button
                            id="_IDGenButton4"
                            text="Investigate"
                            type="Transparent"
                            class="customLinkButton sapUiTinyMarginEnd"
                        />

                        <!-- BULK -->
                       <Button
    id="_IDGenButton5"
    text="Bulk Action"
    type="Emphasized"
    press="onBulkAction"
/>
                    </HBox>

            </VBox>



            <!-- ✅ CLICKABLE HEADER -->
            <Button
                type="Transparent"
                press="onToggleManager"
                icon="sap-icon://slim-arrow-down"
                text="Manager - Daily Startup"
                iconFirst="true"
                id="managerHeader"
                class="managerHeader"
            />

            <!-- ✅ WRAP EVERYTHING BELOW (CRITICAL ✅) -->
            <VBox id="managerContent">
                <!-- ✅ FILTER ROW -->
                <HBox
                    id="_IDGenHBox38"
                    wrap="Wrap"
                    class="sapUiSmallMarginTop"
                    justifyContent="SpaceBetween"
                >
                    <!-- SEARCH -->
                    <VBox id="_IDGenVBox73">
                        <Text
                            id="_IDGenText98"
                            text="Search"
                        />
                        <SearchField
                            id="_IDGenSearchField1"
                            width="260px"
                            placeholder="Search for Customer, Ref., IBAN, BIC..."
                            liveChange="onGlobalSearch"
                        />
                    </VBox>

                    <!-- RAIL -->
                    <VBox id="_IDGenVBox74">
                        <Text
                            id="_IDGenText118"
                            text="Rail"
                        />
                        <Select
                            id="filterRail"
                            change="onFilterChange"
                        >
                            <core:Item
                                id="_IDGenItem2"
                                key="ALL"
                                text="All"
                            />
                           
                        </Select>
                    </VBox>

                    <!-- STATUS -->
                    <VBox id="_IDGenVBox68">
                        <Text
                            id="_IDGenText119"
                            text="Status"
                        />
                        <Select
                            id="filterStatus"
                            change="onFilterChange"
                        >
                            <core:Item
                                id="_IDGenItem6"
                                key="ALL"
                                text="All"
                            />
                            <core:Item
                                id="_IDGenItem7"
                                key="OPEN"
                                text="Open"
                            />
                            <core:Item
                                id="_IDGenItem8"
                                key="PROCESSING"
                                text="Processing"
                            />
                            <core:Item
                                id="_IDGenItem9"
                                key="REJECTED"
                                text="Rejected"
                            />
                        </Select>
                    </VBox>

                    <!-- AGING -->
                    <VBox id="_IDGenVBox69">
                        <Text
                            id="_IDGenText101"
                            text="Aging"
                        />
                        <Select
                            id="filterAging"
                            selectedKey="ALL_AGE"
                            change="onFilterChange"
                        >
                            <core:Item
                                id="_IDGenItem"
                                key="ALL_AGE"
                                text="All Age"
                            />
                        </Select>
                    </VBox>

                    <!-- SEGMENT -->
                   <VBox id="_IDGenVBox70">
    <Text
        id="_IDGenText120"
        text="Object Category"
    />

    <Select
        id="filterObjectCategory"
        width="160px"
        selectedKey="ALL_OBJECT_CATEGORY"
        change="onFilterChange"
    >
        <core:Item id="_IDGenItem1"
            key="ALL_OBJECT_CATEGORY"
            text="All"
        />
    </Select>
</VBox>

                    <!-- REASON -->
                    <VBox id="_IDGenVBox71">
                        <Text
                            id="_IDGenText104"
                            text="Reason Contains"
                        />
                        <Input
                            id="_IDGenInput"
                            width="220px"
                            placeholder="E.g: Sanctions, IBAN"
                            liveChange="onFilterChange"
                        />
                    </VBox>
                </HBox>

                <!-- ✅ DIVIDER -->
                <HBox
                    id="_IDGenHBox41"
                    class="horizontalDivider sapUiTinyMarginTop sapUiTinyMarginBottom"
                />

               

                <!-- SANCTIONS TABLE -->

                <VBox
                    id="_IDGenVBox80"
                    class="sapUiMediumMarginTop tableContainer"
                    height="160px"
                >
      <ScrollContainer
    id="exceptionTableScroll"
    width="100%"
    height="520px"
    vertical="true"
    horizontal="true"
>
    <Table
        id="_IDGenTable3"
        items="{openExceptionModel>/data}"
        mode="MultiSelect"
        includeItemInSelection="true"
        showNoData="false"
        fixedLayout="false"
        width="100%"
    >
                       <columns>

    <Column id="colClearingArea">
        <Text id="_IDGenText55" text="Clearing Area"/>
    </Column>

    <Column id="colPaymentItemDate">
        <Text id="_IDGenText56" text="Payment Item Date"/>
    </Column>

   

    <Column id="colObjectCategory">
        <Text id="_IDGenText58" text="Object Category"/>
    </Column>

     <Column id="_IDGenColumn17" >
        <Text id="_IDGenText6"  text="PO type"/>
    </Column>

     <Column id="_IDGenColumn18" >
        <Text id="_IDGenText27"  text="Po Type Status"/>
    </Column>

    <Column id="colTechStat">
        <Text id="_IDGenText59" text="Technical Status"/>
    </Column>

    <Column id="colPaymentItemNumber">
        <Text id="_IDGenText86" text="Payment Item Number"/>
    </Column>

    <Column id="colReference">
        <Text id="_IDGenText87" text="Reference"/>
    </Column>

    <Column id="colReasonDetail">
