<mvc:View
    controllerName="payment.dashboard.controller.Reconciliation"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:viz="sap.viz.ui5.controls">

    <VBox
        id="reconciliationPage"
        width="100%"
        class="reconciliationPage">

        <!-- ===================================================== -->
        <!-- PAGE HEADER                                           -->
        <!-- ===================================================== -->

        <VBox
            id="reconciliationPageHeader"
            class="reconPageHeader">

            <Title
                id="reconciliationPageTitle"
                text="Reconciliation"
                level="H2"/>

            <Text
                id="reconciliationPageSubtitle"
                text="Evaluation of outgoing items sent to AM System"
                class="reconSubtitle"/>

        </VBox>


        <!-- ===================================================== -->
        <!-- KPI SECTION                                           -->
        <!-- ===================================================== -->

        <VBox
            id="reconciliationKpiSection"
            width="100%"
            class="kpiSectionContainer">

            <FlexBox
                id="reconciliationKpiRow"
                width="100%"
                wrap="NoWrap"
                fitContainer="true"
                renderType="Bare"
                justifyContent="SpaceBetween"
                alignItems="Stretch"
                class="kpiSummaryRow">

                <!-- TOTAL RECON AMOUNT -->

                <GenericTile
                    id="tileTotalReconAmount"
                    header="Total Recon Amount"
                    class="kpiTile kpiTileNoClick">

                    <TileContent
                        id="reconTileContent1">

                        <NumericContent
                            id="reconNumericTotalAmount"
                            value="{reconciliation>/kpi/totalAmount}"
                            scale="EUR"
                            valueColor="Neutral"
                            truncateValueTo="12"
                            withMargin="false"/>

                    </TileContent>

                </GenericTile>


                <!-- TOTAL OBJECTS -->

                <GenericTile
                    id="tileTotalReconObjects"
                    header="Total Reconciliation Objects"
                    class="kpiTile kpiTileNoClick">

                    <TileContent
                        id="reconTileContent2">

                        <NumericContent
                            id="reconNumericTotalObjects"
                            value="{reconciliation>/kpi/totalObjects}"
                            valueColor="Neutral"
                            truncateValueTo="12"
                            withMargin="false"/>

                    </TileContent>

                </GenericTile>


                <!-- DEBIT -->

                <GenericTile
                    id="tileDebitTotal"
                    header="Debit Total"
                    class="kpiTile kpiTileNoClick">

                    <TileContent
                        id="reconTileContent3">

                        <NumericContent
                            id="reconNumericDebit"
                            value="{reconciliation>/kpi/debitTotal}"
                            scale="EUR"
                            valueColor="Error"
                            truncateValueTo="12"
                            withMargin="false"/>

                    </TileContent>

                </GenericTile>


                <!-- CREDIT -->

                <GenericTile
                    id="tileCreditTotal"
                    header="Credit Total"
                    class="kpiTile kpiTileNoClick">

                    <TileContent
                        id="reconTileContent4">

                        <NumericContent
                            id="reconNumericCredit"
                            value="{reconciliation>/kpi/creditTotal}"
                            scale="EUR"
                            valueColor="Good"
                            truncateValueTo="12"
                            withMargin="false"/>

                    </TileContent>

                </GenericTile>

            </FlexBox>

        </VBox>


        <!-- ===================================================== -->
        <!-- RECONCILIATION BAR CHART                              -->
        <!-- ===================================================== -->

        <Panel
            id="reconciliationChartPanel"
            width="100%"
            class="reconChartCard"
            backgroundDesign="Transparent">

            <headerToolbar>

                <OverflowToolbar
                    id="reconciliationChartToolbar">

                    <Title
                        id="reconciliationChartTitle"
                        text="Reconciliation"
                        level="H5"/>

                    <ToolbarSpacer
                        id="reconciliationChartToolbarSpacer"/>

                    <Text
                        id="reconciliationChartTotal"
                        text="{= 'Total Recon Amount: EUR ' + ${reconciliation>/kpi/totalAmount} }"
                        class="reconChartHeaderTotal"/>

                </OverflowToolbar>

            </headerToolbar>


            <content>

                <VBox
                    id="reconciliationChartContainer"
                    width="100%"
                    height="430px"
                    class="reconciliationChartContainer">

                    <viz:VizFrame
                        id="reconciliationBarVizFrame"
                        vizType="column"
                        width="100%"
                        height="400px"
                        uiConfig="{applicationSet:'fiori'}"
                        selectData=".onReconciliationChartSelect"/>

                </VBox>

            </content>

        </Panel>


        <!-- ===================================================== -->
        <!-- RECONCILIATION DETAILS                                -->
        <!-- ===================================================== -->

        <Panel
            id="reconciliationDetailsPanel"
            width="100%"
            class="reconTableCard"
            backgroundDesign="Transparent">

            <headerToolbar>

                <OverflowToolbar
                    id="reconciliationDetailsToolbar">

                    <Title
                        id="reconciliationDetailsTitle"
                        text="Reconciliation Details"
                        level="H4"/>

                    <ToolbarSpacer
                        id="reconciliationDetailsSpacer"/>

                    <Button
                        id="btnExportReconciliation"
                        text="Export to Excel"
                        icon="sap-icon://excel-attachment"
                        type="Transparent"
                        press=".onExportExcel"/>

                </OverflowToolbar>

            </headerToolbar>


            <content>

                <List
                    id="reconciliationGroupList"
                    items="{
                        path: 'reconciliation>/groups',
                        templateShareable: false
                    }"
                    showSeparators="None"
                    class="reconGroupList">

                    <CustomListItem
                        id="reconciliationGroupItem">

                        <VBox
                            id="reconciliationGroupContainer"
                            width="100%"
                            class="reconGroupContainer">

                            <!-- GROUP HEADER -->

                            <HBox
                                id="reconciliationGroupHeader"
                                width="100%"
                                alignItems="Center"
                                class="reconGroupHeader">

                                <Button
                                    id="reconciliationExpandButton"
                                    icon="{= ${reconciliation>expanded} ? 'sap-icon://navigation-down-arrow' : 'sap-icon://navigation-right-arrow' }"
                                    type="Transparent"
                                    press=".onToggleGroup"
                                    class="reconExpandButton"/>


                                <VBox
                                    id="reconciliationGroupTitleBox"
                                    class="reconGroupTitleBox">

                                    <Title
                                        id="reconciliationGroupTitle"
                                        text="{= ${reconciliation>date} + ' · ' + ${reconciliation>currency} + ' · ' + ${reconciliation>direction} }"
                                        level="H5"/>

                                    <Text
                                        id="reconciliationGroupSubtext"
                                        text="Reconciliation Group"
                                        class="reconGroupSubtext"/>

                                </VBox>


                                <ToolbarSpacer
                                    id="reconciliationGroupSpacer"/>


                                <ObjectStatus
                                    id="reconciliationDirectionStatus"
                                    text="{reconciliation>direction}"
                                    state="{reconciliation>directionState}"
                                    class="reconDirectionStatus"/>


                                <VBox
                                    id="reconciliationSubtotal"
                                    alignItems="End"
                                    class="reconSubtotal">

                                    <Text
                                        id="reconciliationSubtotalCount"
                                        text="{= ${reconciliation>count} + ' objects' }"
                                        class="reconSubtotalCount"/>

                                    <ObjectNumber
                                        id="reconciliationSubtotalNumber"
                                        number="{reconciliation>amount}"
                                        unit="{reconciliation>currency}"
                                        emphasized="true"/>

                                </VBox>

                            </HBox>


                            <!-- DETAIL TABLE -->

                            <Table
                                id="reconciliationDetailTable"
                                width="100%"
                                inset="false"
                                visible="{reconciliation>expanded}"
                                items="{
                                    path: 'reconciliation>details',
                                    templateShareable: false
                                }"
                                class="reconDetailTable">

                                <columns>

                                    <Column
                                        id="colAccountManagement">

                                        <Text
                                            id="txtAccountManagement"
                                            text="Acct Mgmt"/>

                                    </Column>


                                    <Column
                                        id="colSystemId">

                                        <Text
                                            id="txtSystemId"
                                            text="System ID"/>

                                    </Column>


                                    <Column
                                        id="colApplicationId">

                                        <Text
                                            id="txtApplicationId"
                                            text="Appl. ID"/>

                                    </Column>


                                    <Column
                                        id="colAddId">

                                        <Text
                                            id="txtAddId"
                                            text="Add. ID"/>

                                    </Column>


                                    <Column
                                        id="colReconGroupKey">

                                        <Text
                                            id="txtReconGroupKey"
                                            text="Reconc. Grp Key"/>

                                    </Column>


                                    <Column
                                        id="colPaymentItemCategory">

                                        <Text
                                            id="txtPaymentItemCategory"
                                            text="Payment Item Category"/>

                                    </Column>


                                    <Column
                                        id="colReconObjects"
                                        hAlign="End">

                                        <Text
                                            id="txtReconObjects"
                                            text="No. of Rcn Obj."/>

                                    </Column>


                                    <Column
                                        id="colReconAmount"
                                        hAlign="End">

                                        <Text
                                            id="txtReconAmount"
                                            text="Recon. Amount"/>

                                    </Column>

                                </columns>


                                <items>

                                    <ColumnListItem
                                        id="reconciliationDetailRow">

                                        <cells>

                                            <Text
                                                id="cellAccountManagement"
                                                text="{reconciliation>AccountManagement}"/>

                                            <Text
                                                id="cellSystemId"
                                                text="{reconciliation>SystemId}"/>

                                            <Text
                                                id="cellApplicationId"
                                                text="{reconciliation>ApplicationId}"/>

                                            <Text
                                                id="cellAddId"
                                                text="{reconciliation>AddId}"/>

                                            <Text
                                                id="cellReconGroupKey"
                                                text="{reconciliation>ReconciliationGroupKey}"/>

                                            <Text
                                                id="cellPaymentItemCategory"
                                                text="{reconciliation>PaymentItemCategory}"/>

                                            <ObjectNumber
                                                id="cellReconObjects"
                                                number="{reconciliation>ReconciliationObjects}"/>

                                            <ObjectNumber
                                                id="cellReconAmount"
                                                number="{reconciliation>ReconciliationAmount}"
                                                unit="EUR"/>

                                        </cells>

                                    </ColumnListItem>

                                </items>

                            </Table>

                        </VBox>

                    </CustomListItem>

                </List>

            </content>

        </Panel>

    </VBox>

</mvc:View>