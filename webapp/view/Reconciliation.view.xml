<mvc:View
    controllerName="payment.dashboard.controller.Reconciliation"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:viz="sap.viz.ui5.controls"
>
    <VBox
        id="reconciliationPage"
        width="100%"
        class="reconciliationPage"
    >
        <!-- ===================================================== -->
        <!-- PAGE HEADER                                           -->
        <!-- ===================================================== -->

        <VBox
            id="reconciliationHeaderSection"
            width="100%"
            class="reconciliationHeaderSection"
        >
            <Title
                id="reconciliationPageTitle"
                text="Reconciliation"
                level="H2"
            />

            <Text
                id="reconciliationPageSubtitle"
                text="Evaluation of outgoing items sent to AM System"
                class="reconSubtitle"
            />
        </VBox>

        <!-- ===================================================== -->
        <!-- SYSTEM FILTERS                                        -->
        <!-- ===================================================== -->

        <VBox
            id="reconciliationFilterCard"
            width="100%"
            class="reconciliationFilterCard"
        >
            <HBox
                id="reconciliationFilterHeader"
                width="100%"
                alignItems="Center"
                class="reconciliationFilterHeader"
            >
                <VBox id="reconciliationFilterTitleBox">
                    <Title
                        id="reconciliationFilterTitle"
                        text="Reconciliation Systems"
                        level="H5"
                    />

                    <Text
                        id="reconciliationFilterDescription"
                        text="Select the source and target system for reconciliation"
                        class="reconciliationFilterDescription"
                    />
                </VBox>
            </HBox>

            <HBox
                id="reconciliationSystemFilterBar"
                width="100%"
                justifyContent="Start"
                alignItems="End"
                class="reconciliationFilterBar"
            >
                <!-- SYSTEM 1 -->

                <VBox
                    id="system1FilterContainer"
                    width="200px"
                    class="reconciliationFilterItem"
                >
                    <Label
                        id="system1Label"
                        text="Source System"
                        labelFor="system1Select"
                    />

                    <Select
                        id="system1Select"
                        width="100%"
                        selectedKey="{reconciliation>/filters/system1}"
                        change=".onSystem1Change"
                    >
                        <core:Item
                            id="system1EmptyItem"
                            key=""
                            text="Select System "
                        />

                        <core:Item
                            id="system1PCItem"
                            key="PC"
                            text="PC"
                        />

                        <core:Item
                            id="system1DMItem"
                            key="DM"
                            text="DM"
                        />
                    </Select>
                </VBox>

                <!-- SYSTEM 2 -->

                <VBox
                    id="system2FilterContainer"
                    width="200px"
                    class="reconciliationFilterItem"
                >
                    <Label
                        id="system2Label"
                        text="Target System"
                        labelFor="system2Select"
                    />

                    <Select
                        id="system2Select"
                        width="100%"
                        selectedKey="{reconciliation>/filters/system2}"
                        change=".onSystem2Change"
                    >
                        <core:Item
                            id="system2EmptyItem"
                            key=""
                            text="Select System"
                        />

                        <core:Item
                            id="system2DMItem"
                            key="DM"
                            text="DM"
                        />
                    </Select>
                </VBox>

                <!-- RESET -->

                <Button
                    id="reconciliationFilterResetButton"
                    text="Reset"
                    icon="sap-icon://reset"
                    type="Default"
                    press=".onResetSystemFilters"
                    class="reconciliationFilterReset"
                />
            </HBox>
        </VBox>

        <!-- ===================================================== -->
        <!-- RECONCILIATION CHART                                  -->
        <!-- ===================================================== -->

        <Panel
            id="reconciliationChartPanel"
            width="100%"
            class="reconChartCard"
            backgroundDesign="Transparent"
        >
            <headerToolbar>
                <OverflowToolbar id="reconciliationChartToolbar">
                    <Title
                        id="reconciliationChartTitle"
                        text="Reconciliation"
                        level="H5"
                    />

                    <ToolbarSpacer id="reconciliationChartToolbarSpacer" />

                    <Button
                        id="reconChartTypeButton"
                        icon="sap-icon://bar-chart"
                        type="Default"
                        tooltip="Change chart type"
                        press=".onReconChartTypeMenuPress"
                        class="chartToolbarButton"
                    />
                </OverflowToolbar>
            </headerToolbar>

            <content>
                <VBox
                    id="reconciliationChartContainer"
                    width="100%"
                    height="430px"
                    class="reconciliationChartContainer"
                >
                    <viz:VizFrame
                        id="reconciliationBarVizFrame"
                        vizType="column"
                        width="100%"
                        height="400px"
                        uiConfig="{applicationSet:'fiori'}"
                        selectData=".onReconciliationChartSelect"
                    />
                </VBox>
            </content>
        </Panel>

        <!-- ===================================================== -->
        <!-- RECONCILIATION DETAILS                                -->
        <!-- ===================================================== -->

        <Panel
            id="reconciliationDetailsPanel"
            width="100%"
            class="reconTableCard"
            backgroundDesign="Transparent"
        >
            <headerToolbar>
                <OverflowToolbar id="reconciliationDetailsToolbar">
                    <Title
                        id="reconciliationDetailsTitle"
                        text="Reconciliation Details"
                        level="H4"
                    />

                    <ToolbarSpacer id="reconciliationDetailsSpacer" />

                    <Button
                        id="btnExportReconciliation"
                        text="Export to Excel"
                        icon="sap-icon://excel-attachment"
                        type="Transparent"
                        press=".onExportExcel"
                    />

                    <Button
                        id="reconColumnSettingsButton"
                        icon="sap-icon://action-settings"
                        type="Transparent"
                        tooltip="Select Columns"
                        press=".onReconColumnSettingsPress"
                        class="chartToolbarButton"
                    />

                    <!-- ✅ ADDED: maximize/restore, same pattern as
                 trendExpandButton in Exceptions.view.xml -->
                    <Button
                        id="reconDetailsExpandButton"
                        icon="sap-icon://full-screen"
                        type="Default"
                        tooltip="Maximize"
                        press=".onToggleReconDetailsSize"
                        class="chartToolbarButton"
                    />
                </OverflowToolbar>
            </headerToolbar>

            <content>
                <!-- Scrollable details area -->

                <ScrollContainer
                    id="reconciliationDetailsScroll"
                    width="100%"
                    height="500px"
                    vertical="true"
                    horizontal="false"
                >
                    <List
                        id="reconciliationGroupList"
                        width="100%"
                        items="{
                            path: 'reconciliation>/groups',
                            templateShareable: false
                        }"
                        showSeparators="None"
                        class="reconGroupList"
                    >
                        <CustomListItem
                            id="reconciliationGroupItem"
                            type="Inactive"
                        >
                            <!-- ================================================= -->
                            <!-- BLUE RECONCILIATION GROUP                        -->
                            <!-- ================================================= -->

                            <VBox
                                id="reconciliationGroupContainer"
                                width="100%"
                                class="reconGroupContainer reconGroupRow"
                            >
                                <!-- GROUP HEADER -->

                                <HBox
                                    id="reconciliationGroupHeader"
                                    width="100%"
                                    alignItems="Center"
                                    class="reconGroupHeader"
                                >
                                    <Button
                                        id="reconciliationExpandButton"
                                        icon="{= ${reconciliation>expanded} ? 'sap-icon://navigation-down-arrow' : 'sap-icon://navigation-right-arrow' }"
                                        type="Transparent"
                                        press=".onToggleGroup"
                                        class="reconExpandButton"
                                    />

                                    <VBox
                                        id="reconciliationGroupTitleBox"
                                        class="reconGroupTitleBox"
                                    >
                                        <Title
                                            id="reconciliationGroupTitle"
                                            text="{= ${reconciliation>date} + ' · ' + ${reconciliation>currency} + ' · ' + ${reconciliation>direction} }"
                                            level="H5"
                                            class="reconGroupTitle"
                                        />

                                        <Text
                                            id="reconciliationGroupSubtext"
                                            text="Reconciliation Group"
                                            class="reconGroupSubtext"
                                        />
                                    </VBox>

                                    <ToolbarSpacer
                                        id="reconciliationGroupSpacer"
                                    />

                                    <ObjectStatus
                                        id="reconciliationDirectionStatus"
                                        text="{reconciliation>direction}"
                                        state="{reconciliation>directionState}"
                                        class="reconDirectionStatus"
                                    />

                                    <VBox
                                        id="reconciliationSubtotal"
                                        alignItems="End"
                                        class="reconSubtotal"
                                    >
                                        <Text
                                            id="reconciliationSubtotalCount"
                                            text="{= ${reconciliation>count} + ' objects' }"
                                            class="reconSubtotalCount"
                                        />

                                        <ObjectNumber
                                            id="reconciliationSubtotalNumber"
                                            number="{reconciliation>amount}"
                                            unit="{reconciliation>currency}"
                                            emphasized="true"
                                            class="reconSubtotalNumber"
                                        />
                                    </VBox>
                                </HBox>

                                <!-- ================================================= -->
                                <!-- DETAIL TABLE                                    -->
                                <!-- IMPORTANT: detail rows remain WHITE            -->
                                <!-- ================================================= -->

                                <ScrollContainer
    id="reconciliationHorizontalScroll"
    width="100%"
    horizontal="true"
    vertical="false"
    focusable="true"
    class="reconHorizontalScroll">

    <Table
        id="reconciliationDetailTable"
        width="auto"
        inset="false"
        visible="{reconciliation>expanded}"
        fixedLayout="false"
        class="reconDetailTable"
    />

</ScrollContainer>
                            </VBox>
                        </CustomListItem>
                    </List>
                </ScrollContainer>
            </content>
        </Panel>
    </VBox>
</mvc:View>
