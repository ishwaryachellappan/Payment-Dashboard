<mvc:View
    controllerName="payment.dashboard.controller.Reconciliation"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:fb="sap.ui.comp.filterbar"

>
    <VBox
        id="reconciliationPage"
        width="100%"
        class="reconciliationPage"
    >
        <!-- ===================================================== -->
        <!-- PAGE HEADER                                           -->
        <!-- ===================================================== -->

        <VBox
            id="reconciliationHeaderSection"
            width="100%"
            class="reconciliationHeaderSection"
        >
            <Title
                id="reconciliationPageTitle"
                text="Reconciliation"
                level="H2"
            />

            <Text
                id="reconciliationPageSubtitle"
                text="Evaluation of outgoing items sent to AM System"
                class="reconSubtitle"
            />
        </VBox>

        <!-- ===================================================== -->
        <!-- SYSTEM FILTERS                                        -->
        <!-- ===================================================== -->

       <!-- ===================================================== -->
<!-- RECONCILIATION SYSTEM SELECTION                      -->
<!-- ===================================================== -->

<VBox
    id="reconciliationFilterCard"
    width="100%"
    class="reconciliationFilterCard">

    <!-- ================================================= -->
    <!-- SECTION HEADER                                    -->
    <!-- ================================================= -->

    <HBox
        id="reconciliationFilterHeader"
        width="100%"
        alignItems="Center"
        class="reconciliationFilterHeader">

        <VBox
            id="reconciliationFilterAccent"
            class="reconciliationFilterAccent">
        </VBox>

        <VBox
            id="reconciliationFilterTitleBox"
            class="reconciliationFilterTitleBox">

            <Title
                id="reconciliationFilterTitle"
                text="Reconciliation Systems"
                level="H5"
                class="reconciliationFilterTitle"/>

            <Text
                id="reconciliationFilterDescription"
                text="Select the source and target system for reconciliation"
                class="reconciliationFilterDescription"/>

        </VBox>

    </HBox>


    <!-- ================================================= -->
    <!-- SYSTEM SELECTION ROW                              -->
    <!-- ================================================= -->

    <HBox
        id="reconciliationSystemFilterBar"
        width="100%"
        alignItems="End"
        class="reconciliationSystemFilterBar">

        <!-- ============================================= -->
        <!-- SOURCE SYSTEM                                 -->
        <!-- ============================================= -->

        <VBox
            id="system1FilterContainer"
            width="280px"
            class="reconciliationFilterItem">

            <Label
                id="system1Label"
                text="Source System"
                labelFor="system1Select"
                class="reconciliationFilterLabel"/>

            <Select
                id="system1Select"
                width="100%"
                selectedKey="{reconciliation>/filters/system1}"
                change=".onSystem1Change"
                class="reconciliationSystemSelect">

                <core:Item
                    id="system1EmptyItem"
                    key=""
                    text="Select System"/>

                <core:Item
                    id="system1PCItem"
                    key="PC"
                    text="PC"/>

                <core:Item
                    id="system1DMItem"
                    key="DM"
                    text="DM"/>

            </Select>

            <Text
                id="system1HelperText"
                text="System sending the items"
                class="reconciliationFilterHelper"/>

        </VBox>


        <!-- ============================================= -->
        <!-- TARGET SYSTEM                                 -->
        <!-- ============================================= -->

        <VBox
            id="system2FilterContainer"
            width="280px"
            class="reconciliationFilterItem">

            <Label
                id="system2Label"
                text="Target System"
                labelFor="system2Select"
                class="reconciliationFilterLabel"/>

            <Select
                id="system2Select"
                width="100%"
                selectedKey="{reconciliation>/filters/system2}"
                change=".onSystem2Change"
                class="reconciliationSystemSelect">

                <core:Item
                    id="system2EmptyItem"
                    key=""
                    text="Select System"/>

                <core:Item
                    id="system2DMItem"
                    key="DM"
                    text="DM"/>

            </Select>

            <Text
                id="system2HelperText"
                text="System receiving the items"
                class="reconciliationFilterHelper"/>

        </VBox>


        <!-- ============================================= -->
        <!-- RESET                                          -->
        <!-- ============================================= -->

        <Button
            id="reconciliationFilterResetButton"
            text="Reset"
            icon="sap-icon://reset"
            type="Transparent"
            press=".onResetSystemFilters"
            class="reconciliationFilterReset"/>

    </HBox>

</VBox>

        <!-- ===================================================== -->
        <!-- RECONCILIATION CHART                                  -->
        <!-- ===================================================== -->

        <Panel
            id="reconciliationChartPanel"
            width="100%"
            class="reconChartCard"
            backgroundDesign="Transparent"
        >
            <headerToolbar>
                <OverflowToolbar id="reconciliationChartToolbar">
                    <Title
                        id="reconciliationChartTitle"
                        text="Reconciliation"
                        level="H5"
                    />

                    <ToolbarSpacer id="reconciliationChartToolbarSpacer" />

                    <Button
                        id="reconChartTypeButton"
                        icon="sap-icon://bar-chart"
                        type="Default"
                        tooltip="Change chart type"
                        press=".onReconChartTypeMenuPress"
                        class="chartToolbarButton"
                    />
                </OverflowToolbar>
            </headerToolbar>

            <content>
                <VBox
                    id="reconciliationChartContainer"
                    width="100%"
                    height="430px"
                    class="reconciliationChartContainer"
                >
                    <viz:VizFrame
                        id="reconciliationBarVizFrame"
                        vizType="column"
                        width="100%"
                        height="400px"
                        uiConfig="{applicationSet:'fiori'}"
                        selectData=".onReconciliationChartSelect"
                    />
                </VBox>
            </content>
        </Panel>

        <!-- ===================================================== -->
        <!-- RECONCILIATION DETAILS                                -->
        <!-- ===================================================== -->

        <!-- ===================================================== -->
<!-- RECONCILIATION DETAILS                               -->
<!-- ===================================================== -->

<Panel
    id="reconciliationDetailsPanel"
    width="100%"
    class="reconTableCard"
    backgroundDesign="Transparent"
>

    <!-- ================================================= -->
    <!-- HEADER                                            -->
    <!-- ================================================= -->

    <headerToolbar>

        <OverflowToolbar
            id="reconciliationDetailsToolbar"
            class="reconciliationHeaderToolbar"
        >

            <HBox
                id="reconciliationHeaderLeft"
                alignItems="Center"
                class="reconciliationHeaderLeft"
            >

                <VBox
                    id="reconciliationHeaderIconBox"
                    class="reconciliationHeaderIconBox"
                >
                    <core:Icon
                        id="reconciliationHeaderIcon"
                        src="sap-icon://document-text"
                        size="1.4rem"
                    />
                </VBox>

                <VBox
                    id="reconciliationHeaderTextBox"
                    class="reconciliationHeaderTextBox"
                >

                    <Title
                        id="reconciliationDetailsTitle"
                        text="Reconciliation Details"
                        level="H4"
                        class="reconciliationDetailsTitle"
                    />

                    <Text
                        id="reconciliationDetailsSubtitle"
                        text="View and analyse transaction details "
                        class="reconciliationDetailsSubtitle"
                    />

                </VBox>

            </HBox>


            <ToolbarSpacer
                id="reconciliationDetailsSpacer"
            />


            <!-- Export -->

            <Button
                id="btnExportReconciliation"
               
                icon="sap-icon://download"
                type="Transparent"
                press=".onExportExcel"
                class="reconciliationExportButton"
            />


            <!-- Settings -->

            <Button
                id="reconColumnSettingsButton"
                icon="sap-icon://action-settings"
                type="Default"
                tooltip="Select Columns"
                press=".onReconColumnSettingsPress"
                class="reconciliationHeaderIconButton"
            />


            <!-- Full screen -->

            <Button
                id="reconDetailsExpandButton"
                icon="sap-icon://full-screen"
                type="Default"
                tooltip="Maximize"
                press=".onToggleReconDetailsSize"
                class="reconciliationHeaderIconButton"
            />

        </OverflowToolbar>

    </headerToolbar>


    <!-- ================================================= -->
    <!-- CONTENT                                           -->
    <!-- ================================================= -->

    <content>

        <!-- ============================================= -->
        <!-- SEARCH CARD                                    -->
        <!-- ============================================= -->

        <VBox
            id="reconciliationTableSearchBar"
            width="100%"
            class="reconciliationSearchCard"
        >

            <!-- Search heading -->

            <HBox
                id="reconciliationSearchHeading"
                alignItems="Center"
                class="reconciliationSearchHeading"
            >

                <core:Icon
                    id="reconciliationSearchIcon"
                    src="sap-icon://search"
                    size="1.35rem"
                    class="reconciliationSearchIcon"
                />

                <VBox
                    id="reconciliationSearchHeadingText"
                >

                    <Title
                        id="reconciliationTableSearchTitle"
                        text="Search"
                        level="H5"
                        class="reconciliationSearchTitle"
                    />

                   

                </VBox>

            </HBox>


            <!-- ========================================= -->
            <!-- SEARCH FIELDS                              -->
            <!-- ========================================= -->

            <FlexBox
                id="reconciliationTableSearchFields"
                width="100%"
                wrap="Wrap"
                alignItems="End"
                class="reconciliationSearchFields"
            >

                <!-- PI NUMBER -->

                <VBox
                    id="reconPiNoSearchContainer"
                    class="reconciliationSearchField"
                >

                    <Label
                        id="reconPiNoSearchLabel"
                        text="PI Number"
                        labelFor="reconPiNoSearch"
                    />

                    <Input
                        id="reconPiNoSearch"
                        width="100%"
                        placeholder="Search PI number..."
                        liveChange=".onReconTableSearchLiveChange"
                        class="reconciliationSearchInput"
                    />

                </VBox>


                <!-- PI KIND -->

                <VBox
                    id="reconPiKindSearchContainer"
                    class="reconciliationSearchField"
                >

                    <Label
                        id="reconPiKindSearchLabel"
                        text="PI Kind"
                        labelFor="reconPiKindSearch"
                    />

                    <Input
                        id="reconPiKindSearch"
                        width="100%"
                        placeholder="Search PI kind..."
                        liveChange=".onReconTableSearchLiveChange"
                        class="reconciliationSearchInput"
                    />

                </VBox>


                <!-- REF ITEM TEXT -->

                <VBox
                    id="reconRefItemSearchContainer"
                    class="reconciliationSearchField reconciliationSearchFieldLarge"
                >

                    <Label
                        id="reconRefItemSearchLabel"
                        text="Ref Item Text"
                        labelFor="reconRefItemSearch"
                    />

                    <Input
                        id="reconRefItemSearch"
                        width="100%"
                        placeholder="Search reference item text..."
                        liveChange=".onReconTableSearchLiveChange"
                        class="reconciliationSearchInput"
                    />

                </VBox>



                <!-- RESET -->

                <Button
                    id="reconTableSearchResetButton"
                    text="Reset"
                    icon="sap-icon://reset"
                    type="Transparent"
                    press=".onResetReconTableSearch"
                    class="reconciliationResetButton"
                />

            </FlexBox>

        </VBox>


        <!-- ============================================= -->
        <!-- TABLE AREA                                    -->
        <!-- ============================================= -->

        <ScrollContainer
            id="reconciliationDetailsScroll"
            width="100%"
            height="500px"
            vertical="true"
            horizontal="false"
            class="reconciliationDetailsScroll"
        >

            <List
                id="reconciliationGroupList"
                width="100%"
                items="{
                    path: 'reconciliation>/groups',
                    templateShareable: false
                }"
                showSeparators="None"
                class="reconGroupList"
            >

             

                        <CustomListItem
                            id="reconciliationGroupItem"
                            type="Inactive"
                        >
                            <!-- ================================================= -->
                            <!-- BLUE RECONCILIATION GROUP                        -->
                            <!-- ================================================= -->

                            <VBox
                                id="reconciliationGroupContainer"
                                width="100%"
                                class="reconGroupContainer reconGroupRow"
                            >
                                <!-- GROUP HEADER -->

                                <HBox
                                    id="reconciliationGroupHeader"
                                    width="100%"
                                    alignItems="Center"
                                    class="reconGroupHeader"
                                >
                                    <Button
                                        id="reconciliationExpandButton"
                                        icon="{= ${reconciliation>expanded} ? 'sap-icon://navigation-down-arrow' : 'sap-icon://navigation-right-arrow' }"
                                        type="Transparent"
                                        press=".onToggleGroup"
                                        class="reconExpandButton"
                                    />

                                    <VBox
                                        id="reconciliationGroupTitleBox"
                                        class="reconGroupTitleBox"
                                    >
                                        <Title
                                            id="reconciliationGroupTitle"
                                            text="{= ${reconciliation>date} + ' · ' + ${reconciliation>currency} + ' · ' + ${reconciliation>direction} }"
                                            level="H5"
                                            class="reconGroupTitle"
                                        />

                                        <Text
                                            id="reconciliationGroupSubtext"
                                            text="Reconciliation Group"
                                            class="reconGroupSubtext"
                                        />
                                    </VBox>

                                    <ToolbarSpacer
                                        id="reconciliationGroupSpacer"
                                    />

                                    <ObjectStatus
                                        id="reconciliationDirectionStatus"
                                        text="{reconciliation>direction}"
                                        state="{reconciliation>directionState}"
                                        class="reconDirectionStatus"
                                    />

                                    <VBox
                                        id="reconciliationSubtotal"
                                        alignItems="End"
                                        class="reconSubtotal"
                                    >
                                        <Text
                                            id="reconciliationSubtotalCount"
                                            text="{= ${reconciliation>count} + ' objects' }"
                                            class="reconSubtotalCount"
                                        />

                                        <ObjectNumber
                                            id="reconciliationSubtotalNumber"
                                            number="{reconciliation>amount}"
                                            unit="{reconciliation>currency}"
                                            emphasized="true"
                                            class="reconSubtotalNumber"
                                        />
                                    </VBox>
                                </HBox>

                                <!-- ================================================= -->
                                <!-- DETAIL TABLE                                    -->
                                <!-- IMPORTANT: detail rows remain WHITE            -->
                                <!-- ================================================= -->

                                <ScrollContainer
    id="reconciliationHorizontalScroll"
    width="100%"
    horizontal="true"
    vertical="false"
    focusable="true"
    class="reconHorizontalScroll">

    <Table
        id="reconciliationDetailTable"
        width="auto"
        inset="false"
        visible="{reconciliation>expanded}"
        fixedLayout="false"
        class="reconDetailTable"
    />

</ScrollContainer>
                            </VBox>
                        </CustomListItem>
                    </List>
                </ScrollContainer>
            </content>
        </Panel>
    </VBox>

 

</mvc:View>
