<mvc:View

   controllerName="payment.dashboard.controller.Audit"

   xmlns:mvc="sap.ui.core.mvc"

   xmlns="sap.m"

   xmlns:core="sap.ui.core"

>

   <HBox

       id="auditMasterDetailLayout"

       class="auditMasterDetailLayout"

       alignItems="Stretch"

   >

       <!-- ================================================================= -->

       <!-- PAYMENTS PANEL — full catalog table on open, shrinks to            -->

       <!-- Payment ID + Status once a row is clicked                         -->

       <!-- ================================================================= -->

       <VBox

           id="auditPaymentsPanel"

           width="{= ${auditViewState>/mode} === 'list' ? '100%' : '24%' }"

           class="chartCard auditPaymentsPanel"

       >

<VBox

   id="auditPaymentsHeaderRow"

   width="100%"

   class="auditPaymentsHeaderRow"

   visible="{= ${auditViewState>/mode} === 'detail' }">

   <HBox

       id="auditBackToPaymentsRow"

       alignItems="Center"

       justifyContent="SpaceBetween"

       width="100%">

       <Link

           id="auditBackToListLink"

           text="‹ Back to Payments"

           press="onBackToPaymentsList"/>

       <Button

           id="auditPaymentsRefreshButton"

           icon="sap-icon://refresh"

           type="Transparent"

           tooltip="Refresh"

           press="onRefreshPaymentsList"/>

   </HBox>

   <HBox

       id="auditPaymentsTitleRow"

       alignItems="Center"

       justifyContent="SpaceBetween"

       width="100%"

       class="sapUiTinyMarginTop">

       <Title

           id="auditPaymentsTitle"

           text="{= 'Payments (' + ${auditPayments>/total} + ')' }"

           level="H5"/>

   </HBox>

</VBox>

<VBox

   id="auditPaymentsListHeader"

   width="100%"

   visible="{= ${auditViewState>/mode} === 'list' }">

   <HBox id="_IDGenHBox47" alignItems="Center" justifyContent="SpaceBetween" width="100%">

       <Title

           id="auditPaymentsListTitle"

           text="{= 'Payments (' + ${auditPayments>/total} + ')' }"

           level="H5"/>

       <Button id="_IDGenButton2"

           icon="sap-icon://refresh"

           type="Transparent"

           tooltip="Refresh"

           press="onRefreshPaymentsList"/>

   </HBox>

</VBox>

           <!-- Columns + items are built entirely in the controller

                (_rebuildAuditPaymentsTable) so the same table can switch

                between the full field catalog and the 2-column master list -->

          <!-- Full catalog table — list mode, controller-built columns -->

<ScrollContainer

   id="auditPaymentsScroll"

   width="100%"

   height="480px"

   horizontal="true"

   vertical="true"

   visible="{= ${auditViewState>/mode} === 'list' }"

>

   <Table

       id="auditPaymentsFullTable"

       width="auto"

       fixedLayout="false"

       noDataText="No payments found"

       class="auditPaymentsTable"

   />

</ScrollContainer>

<!-- Narrow 2-column table — detail mode, plain XML binding so the

    selected-row highlight is a simple expression, not manual DOM work -->

<Table

   id="auditPaymentsNarrowTable"

   items="{auditPayments>/pageItems}"

   mode="None"

   showNoData="true"

   noDataText="No payments found"

   class="auditPaymentsNarrowTable"

   visible="{= ${auditViewState>/mode} === 'detail' }"

>

   <columns>

       <Column id="auditPayIdCol"><Text id="auditPayIdColHdr" text="Payment ID"/></Column>

       <Column id="auditPayStatusCol" hAlign="Begin"><Text id="auditPayStatusColHdr" text="Status"/></Column>

   </columns>

   <items>

       <ColumnListItem

           id="auditPaymentRow"

           type="Active"

           press="onPaymentRowPress"

           class="{= ${auditPayments>PaymentId} === ${auditPayments>/selectedPaymentId} ? 'auditRowSelected' : '' }"

       >

           <cells>

               <Text id="auditPayIdVal" text="{auditPayments>PaymentId}" class="auditPayIdText"/>

               <HBox id="auditPayStatusBox" alignItems="Center">

                   <core:Icon

                       id="auditPayStatusDot"

                       src="sap-icon://circle-task"

                       color="{auditPayments>StatusColor}"

                       class="donutLegendDot sapUiTinyMarginEnd"

                   />

                   <Text id="auditPayStatusVal" text="{auditPayments>Status}"/>

               </HBox>

           </cells>

       </ColumnListItem>

   </items>

</Table>

           <HBox

               id="auditPaymentsPagerRow"

               justifyContent="Center"

               alignItems="Center"

               class="sapUiSmallMarginTop auditPaymentsPagerRow"

           >

               <Button

                   id="auditPagerPrev"

                   icon="sap-icon://slim-arrow-left"

                   type="Transparent"

                   enabled="{= ${auditPayments>/currentPage} > 1 }"

                   press="onPagerPrev"

               />

               <HBox

                   id="auditPagerButtons"

                   items="{auditPayments>/pageButtons}"

                   alignItems="Center"

               >

                   <Button

                       id="auditPagerButton"

                       text="{auditPayments>label}"

                       enabled="{= !${auditPayments>ellipsis} }"

                       type="{= ${auditPayments>current} ? 'Emphasized' : 'Transparent' }"

                       press="onPagerButtonPress"

                       class="auditPagerBtn"

                   />

               </HBox>

               <Button

                   id="auditPagerNext"

                   icon="sap-icon://slim-arrow-right"

                   type="Transparent"

                   enabled="{= ${auditPayments>/currentPage} &lt; ${auditPayments>/totalPages} }"

                   press="onPagerNext"

               />

           </HBox>

       </VBox>

       <!-- ================================================================= -->

       <!-- MIDDLE: SELECTED PAYMENT DETAIL + TIMELINE + AUDIT EVENTS         -->

       <!-- Only shown once a payment row has been clicked                    -->

       <!-- ================================================================= -->

    <VBox

   id="auditDetailPanel"

   width="76%"

   visible="{= ${auditViewState>/mode} === 'detail' }"

   class="chartCard auditDetailPanel sapUiTinyMarginBegin">

    <!-- BOX 1: Payment ID, status and all six fields -->

   <VBox

       id="auditPaymentSummaryBox"

       width="100%"

       class="auditPaymentSummaryBox">

           <!-- Payment header -->

           <HBox

               id="auditDetailHeaderRow"

               justifyContent="SpaceBetween"

               alignItems="Center"

               width="100%"

           >

               <HBox id="auditDetailHeaderLeft" alignItems="Center">

                   <Title

                       id="auditDetailPaymentIdTitle"

                       text="{= 'Payment ID: ' + ${auditDetail>/PaymentId} }"

                       level="H4"

                       class="sapUiTinyMarginEnd"

                   />

                   <!-- Payment header pill (was ObjectStatus) -->

<HBox

   id="auditDetailStatusPill"

   alignItems="Center"

   class="{= 'statusPill ' + ${auditDetail>/StatusPillClass} }"

>

   <Text id="auditDetailStatusPillText" text="{auditDetail>/Status}"/>

</HBox>

               </HBox>

               <HBox id="auditDetailHeaderRight" alignItems="Center">

                   <Button

                       id="auditViewPaymentDetailsButton"

                       text="View Payment Details"

                       type="Emphasized"

                       press="onViewPaymentDetails"

                       class="sapUiTinyMarginEnd"

                   />

                  

               </HBox>

           </HBox>

           <!-- Key fields row -->

<HBox

   id="auditDetailFieldsRow"

   width="100%"

   alignItems="Stretch"

   justifyContent="Start"

   wrap="NoWrap"

   class="sapUiSmallMarginTop auditDetailFieldsRow">

   <VBox id="auditFieldAmount" class="auditDetailField">

       <Text id="auditFieldAmountLabel" text="Amount"

           class="auditDetailFieldLabel"/>

       <Text id="auditFieldAmountVal" text="{auditDetail>/Amount}"

           class="auditDetailFieldValue"/>

   </VBox>

   <HBox id="auditFieldDivider1" class="auditFieldDivider"/>

   <VBox id="auditFieldRef" class="auditDetailField">

       <Text id="auditFieldRefLabel" text="Payment Reference"

           class="auditDetailFieldLabel"/>

       <Text id="auditFieldRefVal" text="{auditDetail>/PaymentReference}"

           class="auditDetailFieldValue"/>

   </VBox>

   <HBox id="auditFieldDivider2" class="auditFieldDivider"/>

   <VBox id="auditFieldE2E" class="auditDetailField">

       <Text id="auditFieldE2ELabel" text="End-to-End ID"

           class="auditDetailFieldLabel"/>

       <Text id="auditFieldE2EVal" text="{auditDetail>/EndToEndId}"

           class="auditDetailFieldValue"/>

   </VBox>

   <HBox id="auditFieldDivider3" class="auditFieldDivider"/>

   <VBox id="auditFieldReceived" class="auditDetailField">

       <Text id="auditFieldReceivedLabel" text="Received On"

           class="auditDetailFieldLabel"/>

       <Text id="auditFieldReceivedVal" text="{auditDetail>/ReceivedOn}"

           class="auditDetailFieldValue"/>

   </VBox>

   <HBox id="auditFieldDivider4" class="auditFieldDivider"/>

   <VBox id="auditFieldPosted" class="auditDetailField">

       <Text id="auditFieldPostedLabel" text="Posted On"

           class="auditDetailFieldLabel"/>

       <Text id="auditFieldPostedVal" text="{auditDetail>/PostedOn}"

           class="auditDetailFieldValue"/>

   </VBox>

   <HBox id="auditFieldDivider5" class="auditFieldDivider"/>

   <VBox id="auditFieldRecon" class="auditDetailField">

       <Text id="auditFieldReconLabel" text="Reconciliation"

           class="auditDetailFieldLabel"/>

       <HBox

           id="auditFieldReconVal"

           alignItems="Center"

           class="{= 'statusPill ' + ${auditDetail>/ReconciliationPillClass} }">

           <Text id="auditFieldReconValText"

               text="{auditDetail>/ReconciliationStatus}"/>

       </HBox>

   </VBox>

</HBox>

 </VBox>

 <VBox

       id="auditTimelineBox"

       width="100%"

       class="auditTimelineBox sapUiSmallMarginTop">

           <!-- Timeline -->

         
<HBox
    id="auditTimelineRow"
    width="100%"
    alignItems="Start"
    justifyContent="SpaceBetween"
    class="auditTimelineRow"
    items="{auditTimeline>/steps}">

    <HBox id="_IDGenHBox" alignItems="Start" class="auditTimelineStepWrap">

        <VBox id="_IDGenVBox6" alignItems="Center" class="auditTimelineStep">

            <HBox id="_IDGenHBox42"
                width="2.5rem"
                height="2.5rem"
                alignItems="Center"
                justifyContent="Center"
                class="{= 'auditTimelineIconCircle ' +
                    (${auditTimeline>colorKey} === 'Blue'
                    ? 'auditTimelineIconBlue'
                    : 'auditTimelineIconGreen') }">

                <core:Icon id="_IDGenIcon2"
                    src="{auditTimeline>icon}"
                     color="#000000"
                    size="1.25rem"
                    decorative="false"/>
            </HBox>

            <Text id="_IDGenText128" text="{auditTimeline>label}" class="auditTimelineLabel sapUiTinyMarginTop"/>
            <Text id="_IDGenText129" text="{auditTimeline>time}" class="auditTimelineTime"/>
            <Text id="_IDGenText130" text="{auditTimeline>system}" class="auditTimelineSystem"/>
        </VBox>

        <core:Icon id="_IDGenIcon3"
            src="sap-icon://navigation-right-arrow"
            color="#16A34A"
            size="0.8rem"
            class="auditTimelineConnector"
            visible="{= !${auditTimeline>isLast} }"/>
    </HBox>
</HBox>

 </VBox>

            <!-- BOX 3: Audit Events and Event Details side by side -->
            <HBox
                id="auditBottomSection"
                width="100%"
                alignItems="Stretch"
                class="auditBottomSection sapUiSmallMarginTop">

                <!-- Audit Events table: full width until an event is selected -->
                <VBox
                    id="auditEventsCard"
                    width="100%"
                    class="auditEventsCard">

                    <HBox
                        id="auditEventsHeaderRow"
                        justifyContent="SpaceBetween"
                        alignItems="Center"
                        width="100%">

                        <Title
                            id="auditEventsTitle"
                            text="{= 'Audit Events (' + ${auditEventsTable>/data}.length + ')' }"
                            level="H5"/>

                        <HBox id="auditEventsHeaderActions" alignItems="Center">
                            <Button
                                id="auditEventsFilterButton"
                                icon="sap-icon://filter"
                                type="Transparent"
                                tooltip="Filter"
                                press="onFilterAuditEvents"/>
                            <Button
                                id="auditEventsViewLogsButton"
                                text="View Logs"
                                type="Transparent"
                                icon="sap-icon://log"
                                press="onViewLogs"
                                class="sapUiTinyMarginBegin"/>
                            <Button
                                id="auditEventsSettingsButton"
                                icon="sap-icon://action-settings"
                                type="Transparent"
                                tooltip="Settings"
                                press="onAuditEventsSettings"/>
                            <Button
                                id="auditEventsExportButton"
                                icon="sap-icon://download"
                                type="Transparent"
                                tooltip="Export"
                                press="onExportAuditEvents"/>
                            <Button
                                id="auditEventsExpandButton"
                                icon="sap-icon://full-screen"
                                type="Transparent"
                                tooltip="Maximize"
                                press="onToggleAuditEventsSize"/>
                        </HBox>
                    </HBox>

                    <ScrollContainer
                        id="auditEventsTableScroll"
                        width="100%"
                        horizontal="true"
                        vertical="false"
                        focusable="true"
                        class="auditEventsTableScroll sapUiTinyMarginTop">
                    <Table
                        id="auditEventsTableCtrl"
                        items="{auditEventsTable>/data}"
                        width="64rem"
                        fixedLayout="true"
                        noDataText="No audit events found"
                        class="auditEventsTable">
                        <columns>
                            <Column id="auditEvtTimeCol" width="10rem"><Text id="auditEvtTimeHdr" text="Timestamp"/></Column>
                            <Column id="auditEvtNameCol" width="11rem"><Text id="auditEvtNameHdr" text="Event"/></Column>
                            <Column id="auditEvtSysCol" width="10rem"><Text id="auditEvtSysHdr" text="System"/></Column>
                            <Column id="auditEvtPrevCol" width="7rem"><Text id="auditEvtPrevHdr" text="Previous Status"/></Column>
                            <Column id="auditEvtNewCol" width="7rem"><Text id="auditEvtNewHdr" text="New Status"/></Column>
                            <Column id="auditEvtResultCol" width="6rem"><Text id="auditEvtResultHdr" text="Result"/></Column>
                            <Column id="auditEvtUserCol" width="9rem"><Text id="auditEvtUserHdr" text="User / Service"/></Column>
                            <Column id="auditEvtDetailsCol" width="4rem"><Text id="auditEvtDetailsHdr" text="Details"/></Column>
                        </columns>
                        <items>
                            <ColumnListItem id="auditEvtRow" type="Active" press="onAuditEventRowPress">
                                <cells>
                                    <Text id="auditEvtTimeVal" text="{auditEventsTable>Timestamp}" wrapping="false"/>
                                    <Text id="auditEvtNameVal" text="{auditEventsTable>Event}" wrapping="false"/>
                                    <Text id="auditEvtSysVal" text="{auditEventsTable>System}" wrapping="false"/>
                                    <Text id="auditEvtPrevVal" text="{auditEventsTable>PreviousStatus}" wrapping="false"/>
                                    <Text id="auditEvtNewVal" text="{auditEventsTable>NewStatus}" wrapping="false"/>
                                    <ObjectStatus
                                        id="auditEvtResultVal"
                                        text="{auditEventsTable>Result}"
                                        state="{= ${auditEventsTable>Result} === 'Success' ? 'Success' : 'Error' }"
                                        inverted="true"/>
                                    <Text id="auditEvtUserVal" text="{auditEventsTable>UserService}" wrapping="false"/>
                                    <Link id="auditEvtDetailsVal" text="View" press="onAuditEventRowPress"/>
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                    </ScrollContainer>
                </VBox>

                <!-- Event Details appears beside the table only after a row is selected -->
                <VBox
                    id="auditEventDetailPanel"
                    width="32%"
                    class="chartCard auditEventDetailPanel"
                    visible="{= ${auditViewState>/mode} === 'detail' &amp;&amp; ${auditEventDetail>/visible} }">

                    <HBox
                        id="auditEventDetailHeaderRow"
                        justifyContent="SpaceBetween"
                        alignItems="Center"
                        width="100%">
                        <Title id="auditEventDetailTitle" text="Event Details" level="H5"/>
                        <Button
                            id="auditEventDetailCloseButton"
                            icon="sap-icon://decline"
                            type="Transparent"
                            tooltip="Close event details"
                            press="onCloseEventDetail"/>
                    </HBox>

                    <VBox id="auditEventDetailList" class="sapUiTinyMarginTop auditEventDetailList">
                        <HBox id="_IDGenHBox27" class="auditEventDetailRow"><Text id="_IDGenText68" class="auditEventDetailLabel" text="Event"/><Text id="_IDGenText69" class="auditEventDetailValue" text="{auditEventDetail>/Event}"/></HBox>
                        <HBox id="_IDGenHBox28" class="auditEventDetailRow"><Text id="_IDGenText71" class="auditEventDetailLabel" text="Timestamp"/><Text id="_IDGenText75" class="auditEventDetailValue" text="{auditEventDetail>/Timestamp}"/></HBox>
                        <HBox id="_IDGenHBox29" class="auditEventDetailRow"><Text id="_IDGenText76" class="auditEventDetailLabel" text="System"/><Text id="_IDGenText77" class="auditEventDetailValue" text="{auditEventDetail>/System}"/></HBox>
                        <HBox id="_IDGenHBox30" class="auditEventDetailRow"><Text id="_IDGenText78" class="auditEventDetailLabel" text="Previous Status"/><Text id="_IDGenText79" class="auditEventDetailValue" text="{auditEventDetail>/PreviousStatus}"/></HBox>
                        <HBox id="_IDGenHBox31" class="auditEventDetailRow"><Text id="_IDGenText80" class="auditEventDetailLabel" text="New Status"/><Text id="_IDGenText81" class="auditEventDetailValue" text="{auditEventDetail>/NewStatus}"/></HBox>
                        <HBox id="_IDGenHBox32" class="auditEventDetailRow"><Text id="_IDGenText82" class="auditEventDetailLabel" text="Result"/><ObjectStatus id="_IDGenObjectStatus3" text="{auditEventDetail>/Result}" state="{= ${auditEventDetail>/Result} === 'Success' ? 'Success' : 'Error' }" inverted="true"/></HBox>
                        <HBox id="_IDGenHBox33" class="auditEventDetailRow"><Text id="_IDGenText83" class="auditEventDetailLabel" text="User / Service"/><Text id="_IDGenText95" class="auditEventDetailValue" text="{auditEventDetail>/UserService}"/></HBox>
                        <HBox id="_IDGenHBox34" class="auditEventDetailRow"><Text id="_IDGenText97" class="auditEventDetailLabel" text="Message ID"/><Text id="_IDGenText98" class="auditEventDetailValue" text="{auditEventDetail>/MessageId}"/></HBox>
                        <HBox id="_IDGenHBox35" class="auditEventDetailRow"><Text id="_IDGenText99" class="auditEventDetailLabel" text="Correlation ID"/><Text id="_IDGenText100" class="auditEventDetailValue" text="{auditEventDetail>/CorrelationId}"/></HBox>
                        <HBox id="_IDGenHBox36" class="auditEventDetailRow"><Text id="_IDGenText103" class="auditEventDetailLabel" text="ISO 20022 Message Type"/><Text id="_IDGenText113" class="auditEventDetailValue" text="{auditEventDetail>/IsoMessageType}"/></HBox>
                        <HBox id="_IDGenHBox37" class="auditEventDetailRow"><Text id="_IDGenText114" class="auditEventDetailLabel" text="Error Code"/><Text id="_IDGenText116" class="auditEventDetailValue" text="{auditEventDetail>/ErrorCode}"/></HBox>
                        <HBox id="_IDGenHBox38" class="auditEventDetailRow"><Text id="_IDGenText124" class="auditEventDetailLabel" text="Error Description"/><Text id="_IDGenText125" class="auditEventDetailValue" text="{auditEventDetail>/ErrorDescription}"/></HBox>
                        <HBox id="_IDGenHBox39" class="auditEventDetailRow"><Text id="_IDGenText126" class="auditEventDetailLabel" text="Payload"/><Link id="_IDGenLink" text="View Payload" press="onViewPayload"/></HBox>
                        <HBox id="_IDGenHBox41" class="auditEventDetailRow"><Text id="_IDGenText127" class="auditEventDetailLabel" text="Application Log"/><Link id="_IDGenLink1" text="SLG1 Log" press="onViewAppLog"/></HBox>
                    </VBox>
                </VBox>
            </HBox>
        </VBox>
    </HBox>

</mvc:View>
