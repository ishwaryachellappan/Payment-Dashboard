<mvc:View
    controllerName="payment.dashboard.controller.Audit"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.data="sap.viz.ui5.data"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
>
    <VBox
    id="_IDGenAuditKpiSection"
    class="kpiSectionContainer"
>
    <FlexBox
        id="_IDGenAuditKpiRow"
        wrap="NoWrap"
        fitContainer="true"
        renderType="Bare"
        justifyContent="SpaceBetween"
        alignItems="Stretch"
        width="100%"
        class="kpiSummaryRow"
    >

        <!-- TOTAL AUDIT EVENTS -->
        <VBox id="_IDGenKpiAuditTotal" class="kpiCard kpiCardNoClick" width="100%" height="100%">
            <HBox id="_IDGenKpiAuditTotalTop" class="kpiCardTopRow">
                <Text id="_IDGenKpiAuditTotalLabel" text="Total Audit Events" class="kpiCardLabel"/>
                <HBox id="_IDGenKpiAuditTotalIconBox" class="kpiIconBox kpiIconBlue">
                    <core:Icon id="_IDGenKpiAuditTotalIcon" src="sap-icon://history"/>
                </HBox>
            </HBox>
            <Text id="_IDGenKpiAuditTotalValue" text="1245" class="kpiCardValue kpiValueBlue"/>
            <Text id="_IDGenKpiAuditTotalSub" text="" class="kpiCardSubtext"/>
        </VBox>

        <!-- CRITICAL EVENTS -->
        <VBox id="_IDGenKpiAuditCritical" class="kpiCard kpiCardNoClick" width="100%" height="100%">
            <HBox id="_IDGenKpiAuditCriticalTop" class="kpiCardTopRow">
                <Text id="_IDGenKpiAuditCriticalLabel" text="Critical Events" class="kpiCardLabel"/>
                <HBox id="_IDGenKpiAuditCriticalIconBox" class="kpiIconBox kpiIconDarkRed">
                    <core:Icon id="_IDGenKpiAuditCriticalIcon" src="sap-icon://error"/>
                </HBox>
            </HBox>
            <Text id="_IDGenKpiAuditCriticalValue" text="23" class="kpiCardValue kpiValueDarkRed"/>
            <Text id="_IDGenKpiAuditCriticalSub" text="" class="kpiCardSubtext"/>
        </VBox>

        <!-- WARNING EVENTS -->
        <VBox id="_IDGenKpiAuditWarning" class="kpiCard kpiCardNoClick" width="100%" height="100%">
            <HBox id="_IDGenKpiAuditWarningTop" class="kpiCardTopRow">
                <Text id="_IDGenKpiAuditWarningLabel" text="Warning Events" class="kpiCardLabel"/>
                <HBox id="_IDGenKpiAuditWarningIconBox" class="kpiIconBox kpiIconOrange">
                    <core:Icon id="_IDGenKpiAuditWarningIcon" src="sap-icon://alert"/>
                </HBox>
            </HBox>
            <Text id="_IDGenKpiAuditWarningValue" text="58" class="kpiCardValue kpiValueOrange"/>
            <Text id="_IDGenKpiAuditWarningSub" text="" class="kpiCardSubtext"/>
        </VBox>

        <!-- RESOLVED EVENTS -->
        <VBox id="_IDGenKpiAuditResolved" class="kpiCard kpiCardNoClick" width="100%" height="100%">
            <HBox id="_IDGenKpiAuditResolvedTop" class="kpiCardTopRow">
                <Text id="_IDGenKpiAuditResolvedLabel" text="Resolved Events" class="kpiCardLabel"/>
                <HBox id="_IDGenKpiAuditResolvedIconBox" class="kpiIconBox kpiIconGreen">
                    <core:Icon id="_IDGenKpiAuditResolvedIcon" src="sap-icon://accept"/>
                </HBox>
            </HBox>
            <Text id="_IDGenKpiAuditResolvedValue" text="1160" class="kpiCardValue kpiValueGreen"/>
            <Text id="_IDGenKpiAuditResolvedSub" text="" class="kpiCardSubtext"/>
        </VBox>

        <!-- FAILED EVENTS -->
        <VBox id="_IDGenKpiAuditFailed" class="kpiCard kpiCardNoClick" width="100%" height="100%">
            <HBox id="_IDGenKpiAuditFailedTop" class="kpiCardTopRow">
                <Text id="_IDGenKpiAuditFailedLabel" text="Failed Events" class="kpiCardLabel"/>
                <HBox id="_IDGenKpiAuditFailedIconBox" class="kpiIconBox kpiIconRed">
                    <core:Icon id="_IDGenKpiAuditFailedIcon" src="sap-icon://decline"/>
                </HBox>
            </HBox>
            <Text id="_IDGenKpiAuditFailedValue" text="4" class="kpiCardValue kpiValueRed"/>
            <Text id="_IDGenKpiAuditFailedSub" text="" class="kpiCardSubtext"/>
        </VBox>

    </FlexBox>
</VBox>

    <HBox
        id="_IDGenHBox125"
        justifyContent="SpaceBetween"
        class="sapUiMediumMarginTop"
    >
        <!-- Audit Trend -->
        <VBox
            id="_IDGenVBox7"
            width="60%"
            class="chartCard sapUiSmallPadding"
        >
            <HBox
                id="_IDGenAuditTrendHeaderRow"
                justifyContent="SpaceBetween"
                alignItems="Center"
                width="100%"
            >
                <VBox id="_IDGenAuditTrendTitleBox">
                    <Title
                        id="_IDGenTitle8"
                        text="Audit Trend"
                    />

                    <Text
                        id="_IDGenText225"
                        text="Audit Events - Last 7 Days"
                        class="sapUiSmallMarginBottom"
                    />
                </VBox>

                <HBox
                    id="_IDGenAuditTrendControlsGroup"
                    alignItems="Center"
                >
                    <!-- Maximize / Restore -->
                    <Button
                        id="auditTrendExpandButton"
                        icon="sap-icon://full-screen"
                        type="Default"
                        tooltip="Maximize"
                        press="onToggleAuditTrendSize"
                        class="chartToolbarButton sapUiTinyMarginBegin"
                    />

                    <Select
                        id="auditGranularitySelect"
                        selectedKey="Day"
                        change="onAuditGranularityChange"
                        width="110px"
                        class="sapUiTinyMarginBegin"
                    >
                        <core:Item
                            id="_IDGenAuditGranDay"
                            key="Day"
                            text="Daily"
                        />
                        <core:Item
                            id="_IDGenAuditGranHour"
                            key="Hour"
                            text="Hourly"
                        />
                    </Select>
                </HBox>
            </HBox>

            <viz:VizFrame
                id="auditTrendChart"
                vizType="line"
                width="100%"
                height="320px"
                vizProperties='{
                "title": { "visible": false },
                "legend": {
                    "visible": true,
                    "position": "top",
                    "alignment": "center"
                },
                "plotArea": {
                    "colorPalette": ["#0A6ED1", "#E9730C"]
                }
            }'
                xmlns:viz="sap.viz.ui5.controls"
                xmlns:viz.data="sap.viz.ui5.data"
                xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
            >
                <viz:dataset>
                    <viz.data:FlattenedDataset
                        id="_IDGenFlattenedDataset7"
                        data="{auditTrend>/data}"
                    >
                        <viz.data:dimensions>
                            <viz.data:DimensionDefinition
                                id="_IDGenDimensionDefinition8"
                                name="Day"
                                value="{auditTrend>day}"
                            />
                        </viz.data:dimensions>

                        <viz.data:measures>
                            <viz.data:MeasureDefinition
                                id="_IDGenMeasureDefinition7"
                                name="Success"
                                value="{auditTrend>success}"
                            />

                            <viz.data:MeasureDefinition
                                id="_IDGenMeasureDefinition9"
                                name="Failed"
                                value="{auditTrend>failed}"
                            />
                        </viz.data:measures>
                    </viz.data:FlattenedDataset>
                </viz:dataset>

                <viz:feeds>
                    <viz.feeds:FeedItem
                        id="_IDGenFeedItem17"
                        uid="valueAxis"
                        type="Measure"
                        values="Success,Failed"
                    />

                    <viz.feeds:FeedItem
                        id="_IDGenFeedItem18"
                        uid="categoryAxis"
                        type="Dimension"
                        values="Day"
                    />
                </viz:feeds>
            </viz:VizFrame>
        </VBox>

        <!-- Donut -->

        <VBox
            id="_IDGenVBox141"
            width="38%"
            class="chartCard sapUiSmallPadding"
        >
            <Title
                id="_IDGenTitle41"
                text="Severity Distribution"
            />

            <Text
                id="_IDGenText230"
                text="Today's Audit Events"
                class="sapUiSmallMarginBottom"
            />

            <viz:VizFrame
                id="auditDonut"
                vizType="donut"
                width="100%"
                height="280px"
                vizProperties='{
                "title": { "visible": false },
                "legend": {
                    "visible": true,
                    "position": "right",
                    "alignment": "center"
                }
            }'
                xmlns:viz="sap.viz.ui5.controls"
                xmlns:viz.data="sap.viz.ui5.data"
                xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
            >
                <viz:dataset>
                    <viz.data:FlattenedDataset
                        id="_IDGenFlattenedDataset8"
                        data="{auditSeverity>/data}"
                    >
                        <viz.data:dimensions>
                            <viz.data:DimensionDefinition
                                id="_IDGenDimensionDefinition9"
                                name="Severity"
                                value="{auditSeverity>severity}"
                            />
                        </viz.data:dimensions>

                        <viz.data:measures>
                            <viz.data:MeasureDefinition
                                id="_IDGenMeasureDefinition10"
                                name="Count"
                                value="{auditSeverity>count}"
                            />
                        </viz.data:measures>
                    </viz.data:FlattenedDataset>
                </viz:dataset>

                <viz:feeds>
                    <viz.feeds:FeedItem
                        id="_IDGenFeedItem19"
                        uid="size"
                        type="Measure"
                        values="Count"
                    />

                    <viz.feeds:FeedItem
                        id="_IDGenFeedItem20"
                        uid="color"
                        type="Dimension"
                        values="Severity"
                    />
                </viz:feeds>
            </viz:VizFrame>
        </VBox>
    </HBox>

    <!-- Last row: Recent Audit Events (60%) + Top Event Types bar chart (40%) -->
    <HBox
        id="_IDGenHBox128"
        justifyContent="SpaceBetween"
        class="sapUiMediumMarginTop"
    >
        <!-- Recent Audit Events -->
        <VBox
            id="_IDGenVBox144"
            width="60%"
            class="chartCard sapUiSmallPadding"
        >
            <!-- Header -->
            <HBox
                id="_IDGenHBox126"
                justifyContent="SpaceBetween"
                alignItems="Center"
            >
                <Title
                    id="_IDGenTitle42"
                    text="Recent Audit Events"
                    level="H5"
                />

                <HBox id="_IDGenHBox127">
                    <SearchField
                        id="_IDGenSearchField"
                        width="220px"
                        placeholder="Search Audit Events..."
                        liveChange="onAuditSearch"
                        class="sapUiTinyMarginEnd"
                    />

                    <Button
                        id="_IDGenButton20"
                        icon="sap-icon://action-settings"
                        type="Transparent"
                        tooltip="Settings"
                        press="onAuditTableSettings"
                    />

                    <Button
                        id="_IDGenButton21"
                        icon="sap-icon://excel-attachment"
                        type="Transparent"
                        tooltip="Export"
                        press="onExportAuditEvents"
                    />

                    <Button
                        id="auditTableExpandButton"
                        icon="sap-icon://full-screen"
                        type="Transparent"
                        tooltip="Maximize"
                        press="onToggleAuditTableSize"
                    />
                </HBox>
            </HBox>

            <Table
                id="auditTable"
                items="{auditTable>/data}"
            >
                <columns>
                    <Column id="_IDGenColumn5">
                        <Text
                            id="_IDGenText231"
                            text="Time"
                        />
                    </Column>

                    <Column id="_IDGenColumn6">
                        <Text
                            id="_IDGenText232"
                            text="User"
                        />
                    </Column>

                    <Column id="_IDGenColumn7">
                        <Text
                            id="_IDGenText233"
                            text="Action"
                        />
                    </Column>

                    <Column id="_IDGenColumn8">
                        <Text
                            id="_IDGenText234"
                            text="Object"
                        />
                    </Column>

                    <Column id="_IDGenColumn9">
                        <Text
                            id="_IDGenText235"
                            text="Severity"
                        />
                    </Column>

                    <Column id="_IDGenColumn10">
                        <Text
                            id="_IDGenText236"
                            text="Status"
                        />
                    </Column>
                </columns>

                <items>
                    <ColumnListItem
                        id="_IDGenColumnListItem2"
                        type="Navigation"
                    >
                        <cells>
                            <Text
                                id="_IDGenText237"
                                text="{auditTable>time}"
                            />

                            <Text
                                id="_IDGenText238"
                                text="{auditTable>user}"
                            />

                            <Text
                                id="_IDGenText239"
                                text="{auditTable>action}"
                            />

                            <Text
                                id="_IDGenText240"
                                text="{auditTable>object}"
                            />

                            <ObjectStatus
                                id="_IDGenObjectStatus25"
                                text="{auditTable>severity}"
                                state="{auditTable>state}"
                            />

                            <ObjectStatus
                                id="_IDGenObjectStatus26"
                                text="{auditTable>status}"
                                state="Success"
                            />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>

            <Link
                id="_IDGenLinkAuditViewAll"
                text="View all"
                press="onViewAllAuditEvents"
                class="sapUiTinyMarginTop"
            />
        </VBox>

        <!-- Top Event Types (bar chart) -->
        <VBox
            id="_IDGenVBoxTopEventTypes"
            width="38%"
            class="chartCard sapUiSmallPadding"
        >
            <Title
                id="_IDGenTitleTopEventTypes"
                text="Top Event Types"
                level="H5"
            />

            <!-- Plain VBox with a bound template (same pattern as the working
             Exceptions-tab "Top Reasons" list) instead of a List/CustomListItem —
             List rows add their own left padding/selection gutter, which is why
             the bars were not all starting at the same x-position before. -->
            <VBox
                id="topEventTypesList"
                items="{auditEventTypes>/data}"
                class="sapUiTinyMarginTop"
            >
                <HBox
                    id="_IDGenHBoxTopEventTypeRow"
                    alignItems="Center"
                    class="topReasonRow"
                >
                    <Text
                        id="_IDGenTextTopEventTypeName"
                        text="{auditEventTypes>type}"
                        class="topReasonName"
                    />

                    <HBox
                        id="_IDGenHBoxTopEventTypeBarWrap"
                        alignItems="Center"
                        class="topBarWrap"
                    >
                        <VBox
                            id="_IDGenVBoxTopEventTypeBarTrack"
                            class="topBarTrack"
                        >
                            <HBox
                                id="_IDGenHBoxTopEventTypeBarFill"
                                width="{auditEventTypes>percent}%"
                                alignItems="Center"
                                justifyContent="End"
                                class="topBarFill"
                            >
                                <VBox
                                    id="_IDGenVBoxTopEventTypeBarDot"
                                    class="topBarDot"
                                />
                            </HBox>
                        </VBox>
                    </HBox>

                    <Text
                        id="_IDGenTextTopEventTypeValue"
                        text="{auditEventTypes>count} ({auditEventTypes>percent}%)"
                        class="topReasonValue"
                    />
                </HBox>
            </VBox>

            <Link
                id="_IDGenLinkTopEventTypesViewAll"
                text="View all"
                press="onViewAllEventTypes"
                class="sapUiTinyMarginTop"
            />
        </VBox>
    </HBox>
</mvc:View>
