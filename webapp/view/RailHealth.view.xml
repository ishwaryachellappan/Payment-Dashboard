<mvc:View
    controllerName="payment.dashboard.controller.RailHealth"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <VBox
        id="_IDGenVBox5"
        width="100%"
        class="sapUiTinyMargin">


        <!-- ========================================================= -->
        <!-- KPI SECTION -->
        <!-- ========================================================= -->

        <!-- ========================================================= -->
<!-- KPI SECTION -->
<!-- ========================================================= -->

<ScrollContainer
    id="_IDGenScrollContainer1"
    horizontal="false"
    vertical="false"
    class="sapUiSmallMarginBottom"
    width="100%"
    height="auto">

    <VBox
        id="_IDGenRailKpiSection"
        width="100%"
        class="kpiSectionContainer">

        <FlexBox
            id="_IDGenRailKpiRow"
            wrap="Wrap"
            fitContainer="true"
            renderType="Bare"
            width="100%"
            class="railKpiRow">


            <!-- ================================================= -->
            <!-- OVERALL HEALTH -->
            <!-- ================================================= -->

            <VBox
                id="_IDGenKpiOverallHealth"
                class="kpiCard kpiCardNoClick"
                width="100%"
                height="100%">

                <Text
                    id="_IDGenKpiOverallHealthLabel"
                    text="{i18n>overallHealth}"
                    class="kpiCardLabel"/>

                <HBox
                    id="_IDGenKpiOverallHealthValueRow"
                    class="kpiValueRow"
                    alignItems="Center"
                    justifyContent="SpaceBetween">

                    <Text
                        id="_IDGenKpiOverallHealthValue"
                        text="{railHealth>/kpis/overallHealth}"
                        class="kpiCardValue kpiValueGreen"/>

                    <HBox
                        id="_IDGenKpiOverallHealthIconBox"
                        class="kpiIconBox kpiIconGreen">

                        <core:Icon
                            id="_IDGenKpiOverallHealthIcon"
                            src="sap-icon://heart-2"/>

                    </HBox>

                </HBox>

                <Text
                    id="_IDGenKpiOverallHealthSub"
                    text="{railHealth>/kpis/overallHealthSub}"
                    class="kpiCardSubtext"/>

            </VBox>


            <!-- ================================================= -->
            <!-- ACTIVE RAILS -->
            <!-- ================================================= -->

            <VBox
                id="_IDGenKpiActiveRails"
                class="kpiCard kpiCardNoClick"
                width="100%"
                height="100%">

                <Text
                    id="_IDGenKpiActiveRailsLabel"
                    text="{i18n>activeRails}"
                    class="kpiCardLabel"/>

                <HBox
                    id="_IDGenKpiActiveRailsValueRow"
                    class="kpiValueRow"
                    alignItems="Center"
                    justifyContent="SpaceBetween">

                    <Text
                        id="_IDGenKpiActiveRailsValue"
                        text="{railHealth>/kpis/activeRails}"
                        class="kpiCardValue kpiValueBlue"/>

                    <HBox
                        id="_IDGenKpiActiveRailsIconBox"
                        class="kpiIconBox kpiIconBlue">

                        <core:Icon
                            id="_IDGenKpiActiveRailsIcon"
                            src="sap-icon://share-2"/>

                    </HBox>

                </HBox>

                <Text
                    id="_IDGenKpiActiveRailsSub"
                    text="{railHealth>/kpis/activeRailsSub}"
                    class="kpiCardSubtext"/>

            </VBox>


            <!-- ================================================= -->
            <!-- TRANSACTIONS -->
            <!-- ================================================= -->

            <VBox
                id="_IDGenKpiTransactions"
                class="kpiCard kpiCardNoClick"
                width="100%"
                height="100%">

                <Text
                    id="_IDGenKpiTransactionsLabel"
                    text="{i18n>transactions}"
                    class="kpiCardLabel"/>

                <HBox
                    id="_IDGenKpiTransactionsValueRow"
                    class="kpiValueRow"
                    alignItems="Center"
                    justifyContent="SpaceBetween">

                    <Text
                        id="_IDGenKpiTransactionsValue"
                        text="{railHealth>/kpis/transactions}"
                        class="kpiCardValue kpiValuePurple"/>

                    <HBox
                        id="_IDGenKpiTransactionsIconBox"
                        class="kpiIconBox kpiIconPurple">

                        <core:Icon
                            id="_IDGenKpiTransactionsIcon"
                            src="sap-icon://business-objects-experience"/>

                    </HBox>

                </HBox>

                <Text
                    id="_IDGenKpiTransactionsSub"
                    text="{railHealth>/kpis/transactionsSub}"
                    class="kpiCardSubtext"/>

            </VBox>


            <!-- ================================================= -->
            <!-- SUCCESS RATE -->
            <!-- ================================================= -->

            <VBox
                id="_IDGenKpiSuccessRate"
                class="kpiCard kpiCardNoClick"
                width="100%"
                height="100%">

                <Text
                    id="_IDGenKpiSuccessRateLabel"
                    text="{i18n>successRate}"
                    class="kpiCardLabel"/>

                <HBox
                    id="_IDGenKpiSuccessRateValueRow"
                    class="kpiValueRow"
                    alignItems="Center"
                    justifyContent="SpaceBetween">

                    <Text
                        id="_IDGenKpiSuccessRateValue"
                        text="{railHealth>/kpis/successRate}"
                        class="kpiCardValue kpiValueGreen"/>

                    <HBox
                        id="_IDGenKpiSuccessRateIconBox"
                        class="kpiIconBox kpiIconGreen">

                        <core:Icon
                            id="_IDGenKpiSuccessRateIcon"
                            src="sap-icon://accept"/>

                    </HBox>

                </HBox>

                <Text
                    id="_IDGenKpiSuccessRateSub"
                    text="{railHealth>/kpis/successRateSub}"
                    class="kpiCardSubtext"/>

            </VBox>


            <!-- ================================================= -->
            <!-- FAILED PAYMENTS -->
            <!-- ================================================= -->

            <VBox
                id="_IDGenKpiFailedPayments"
                class="kpiCard kpiCardNoClick"
                width="100%"
                height="100%">

                <Text
                    id="_IDGenKpiFailedPaymentsLabel"
                    text="{i18n>failedPayments}"
                    class="kpiCardLabel"/>

                <HBox
                    id="_IDGenKpiFailedPaymentsValueRow"
                    class="kpiValueRow"
                    alignItems="Center"
                    justifyContent="SpaceBetween">

                    <Text
                        id="_IDGenKpiFailedPaymentsValue"
                        text="{railHealth>/kpis/failedPayments}"
                        class="kpiCardValue kpiValueDarkRed"/>

                    <HBox
                        id="_IDGenKpiFailedPaymentsIconBox"
                        class="kpiIconBox kpiIconDarkRed">

                        <core:Icon
                            id="_IDGenKpiFailedPaymentsIcon"
                            src="sap-icon://error"/>

                    </HBox>

                </HBox>

                <Text
                    id="_IDGenKpiFailedPaymentsSub"
                    text="{railHealth>/kpis/failedPaymentsSub}"
                    class="kpiCardSubtext"/>

            </VBox>


            <!-- ================================================= -->
            <!-- RESPONSE TIME -->
            <!-- ================================================= -->

            <VBox
                id="_IDGenKpiResponseTime"
                class="kpiCard kpiCardNoClick"
                width="100%"
                height="100%">

                <Text
                    id="_IDGenKpiResponseTimeLabel"
                    text="{i18n>responseTime}"
                    class="kpiCardLabel"/>

                <HBox
                    id="_IDGenKpiResponseTimeValueRow"
                    class="kpiValueRow"
                    alignItems="Center"
                    justifyContent="SpaceBetween">

                    <Text
                        id="_IDGenKpiResponseTimeValue"
                        text="{railHealth>/kpis/responseTime}"
                        class="kpiCardValue kpiValueBlue"/>

                    <HBox
                        id="_IDGenKpiResponseTimeIconBox"
                        class="kpiIconBox kpiIconBlue">

                        <core:Icon
                            id="_IDGenKpiResponseTimeIcon"
                            src="sap-icon://history"/>

                    </HBox>

                </HBox>

                <Text
                    id="_IDGenKpiResponseTimeSub"
                    text="{railHealth>/kpis/responseTimeSub}"
                    class="kpiCardSubtext"/>

            </VBox>


            <!-- ================================================= -->
            <!-- QUEUE DEPTH -->
            <!-- ================================================= -->

            <VBox
                id="_IDGenKpiQueueDepth"
                class="kpiCard kpiCardNoClick"
                width="100%"
                height="100%">

                <Text
                    id="_IDGenKpiQueueDepthLabel"
                    text="{i18n>queueDepth}"
                    class="kpiCardLabel"/>

                <HBox
                    id="_IDGenKpiQueueDepthValueRow"
                    class="kpiValueRow"
                    alignItems="Center"
                    justifyContent="SpaceBetween">

                    <Text
                        id="_IDGenKpiQueueDepthValue"
                        text="{railHealth>/kpis/queueDepth}"
                        class="kpiCardValue kpiValueOrange"/>

                    <HBox
                        id="_IDGenKpiQueueDepthIconBox"
                        class="kpiIconBox kpiIconOrange">

                        <core:Icon
                            id="_IDGenKpiQueueDepthIcon"
                            src="sap-icon://list"/>

                    </HBox>

                </HBox>

                <Text
                    id="_IDGenKpiQueueDepthSub"
                    text="{railHealth>/kpis/queueDepthSub}"
                    class="kpiCardSubtext"/>

            </VBox>


            <!-- ================================================= -->
            <!-- CRITICAL ALERTS -->
            <!-- ================================================= -->

            <VBox
                id="_IDGenKpiCriticalAlerts"
                class="kpiCard kpiCardNoClick"
                width="100%"
                height="100%">

                <Text
                    id="_IDGenKpiCriticalAlertsLabel"
                    text="{i18n>criticalAlerts}"
                    class="kpiCardLabel"/>

                <HBox
                    id="_IDGenKpiCriticalAlertsValueRow"
                    class="kpiValueRow"
                    alignItems="Center"
                    justifyContent="SpaceBetween">

                    <Text
                        id="_IDGenKpiCriticalAlertsValue"
                        text="{railHealth>/kpis/alerts}"
                        class="kpiCardValue kpiValueDarkRed"/>

                    <HBox
                        id="_IDGenKpiCriticalAlertsIconBox"
                        class="kpiIconBox kpiIconDarkRed">

                        <core:Icon
                            id="_IDGenKpiCriticalAlertsIcon"
                            src="sap-icon://bell"/>

                    </HBox>

                </HBox>

                <Text
                    id="_IDGenKpiCriticalAlertsSub"
                    text="{railHealth>/kpis/alertsSub}"
                    class="kpiCardSubtext"/>

            </VBox>

        </FlexBox>

    </VBox>

</ScrollContainer>

        <!-- ========================================================= -->
        <!-- RAIL HEALTH OVERVIEW -->
        <!-- ========================================================= -->

     <VBox
    id="_IDGenRailOverviewSection"
    width="100%"
    class="railSection railHealthOverviewSection sapUiSmallMarginTop">

            <!-- ===================================================== -->
            <!-- SECTION HEADER -->
            <!-- ===================================================== -->

            <HBox
                id="_IDGenRailOverviewHeader"
                justifyContent="SpaceBetween"
                alignItems="Center"
                class="sectionHeader">

                <Title
                    id="_IDGenRailOverviewTitle"
                    text="{i18n>railHealthOverview}"
                    level="H5"/>

               

            </HBox>


            <!-- ===================================================== -->
            <!-- SEARCH / FILTER -->
            <!-- ===================================================== -->

            <VBox
                id="_IDGenRailSearchSection"
                width="100%"
                class="railSearchSection sapUiSmallMarginTop sapUiSmallMarginBottom">


                <Title
                    id="_IDGenRailSearchTitle"
                    text="Search rails"
                    level="H5"
                    class="railSearchTitle"/>


                <HBox
                    id="_IDGenRailSearchFilters"
                    width="100%"
                    wrap="Wrap"
                    class="railSearchFilters">


                    <!-- RAIL -->

                    <VBox
                        id="_IDGenRailFilterBox"
                        class="railFilterItem">

                        <Label
                            id="_IDGenRailFilterLabel"
                            text="Rail"/>

                        <Select
    id="_IDGenRailFilterSelect"
    width="100%"
    selectedKey="{railHealth>/railFilters/rail}"
    change=".onRailFilterChange"
    items="{railHealth>/availableRails}">

    <core:Item id="_IDGenItem"
        key="{railHealth>key}"
        text="{railHealth>text}"/>

</Select>

                    </VBox>


                    <!-- STATUS -->

                    <VBox
                        id="_IDGenRailStatusFilterBox"
                        class="railFilterItem">

                        <Label
                            id="_IDGenRailStatusFilterLabel"
                            text="Status"/>

                        <Select
                            id="_IDGenRailStatusFilterSelect"
                            width="100%"
                            selectedKey="{railHealth>/railFilters/status}"
                            change=".onRailFilterChange">

                            <core:Item
                                id="_IDGenStatusAll"
                                key="All"
                                text="All"/>

                            <core:Item
                                id="_IDGenStatusHealthy"
                                key="Healthy"
                                text="Healthy"/>

                            <core:Item
                                id="_IDGenStatusWarning"
                                key="Warning"
                                text="Warning"/>

                            <core:Item
                                id="_IDGenStatusCritical"
                                key="Critical"
                                text="Critical"/>

                        </Select>

                    </VBox>

                </HBox>

            </VBox>


            <!-- ===================================================== -->
            <!-- RAIL HEALTH TABLE -->
            <!-- ===================================================== -->
<!-- ===================================================== -->
<!-- RAIL HEALTH TABLE -->
<!-- ===================================================== -->

<VBox
    id="_IDGenRailTableContainer"
    width="100%"
    class="railTableContainer">

    <Table
        id="_IDGenRailOverviewTable"
        width="100%"
        inset="false"
        mode="None"
        class="railOverviewTable"
        items="{
            path: 'railHealth>/filteredRailOverview'
        }">

        <columns>

    <!-- CHECKBOX -->
    <Column
        id="_IDGenRailSelectColumn"
        width="3rem"
        hAlign="Center">

        <header>
            <CheckBox
                id="_IDGenRailSelectAll"
                selected="{railHealth>/allRailsSelected}"
                select=".onRailSelectAll"/>
        </header>

    </Column>


    <!-- CHANNEL -->
    <Column
        id="_IDGenRailChannelColumn"
        width="15%">

        <Text
            id="_IDGenRailChannelColumnText"
            text="Channel"/>

    </Column>


    <!-- STATUS -->
    <Column
        id="_IDGenStatusColumn"
        width="15%">

        <Text
            id="_IDGenStatusColumnText"
            text="Status"/>

    </Column>


    <!-- SUCCESS RATE -->
    <Column
        id="_IDGenSuccessColumn"
        width="15%">

        <Text
            id="_IDGenSuccessColumnText"
            text="Success Rate"/>

    </Column>


    <!-- AVG RESPONSE -->
    <Column
        id="_IDGenResponseColumn"
        width="15%">

        <Text
            id="_IDGenResponseColumnText"
            text="Avg Response"/>

    </Column>


    <!-- MEDIUM -->
    <Column
        id="_IDGenRailMediumColumn"
        width="15%">

        <Text
            id="_IDGenRailMediumColumnText"
            text="Medium"/>

    </Column>


    <!-- QUEUE DEPTH -->
    <Column
        id="_IDGenQueueDepthColumn"
        width="15%">

        <Text
            id="_IDGenQueueDepthColumnText"
            text="Queue Depth"/>

    </Column>


    <!-- CREATED ON -->
    <Column
        id="_IDGenCreatedOnColumn"
        width="15%">

        <Text
            id="_IDGenCreatedOnColumnText"
            text="Created On"/>

    </Column>

</columns>


<items>

    <ColumnListItem
        id="_IDGenRailColumnListItem"
        type="Navigation"
        press=".onRailRowPress">

        <cells>

            <!-- CHECKBOX -->
            <CheckBox
                id="_IDGenRailRowCheckBox"
                selected="{railHealth>selected}"
                select=".onRailRowSelect"/>


            <!-- 1. CHANNEL -->
            <Text
                id="_IDGenRailChannelText"
                text="{railHealth>channel}"/>


            <!-- 2. STATUS -->
            <Text
                id="_IDGenRailStatus"
                text="{railHealth>status}"/>


            <!-- 3. SUCCESS RATE -->
            <Text
                id="_IDGenRailSuccessText"
                text="{railHealth>successRate}"/>


            <!-- 4. AVG RESPONSE -->
            <Text
                id="_IDGenRailResponseText"
                text="{railHealth>responseTime}"/>


            <!-- 5. MEDIUM -->
            <Text
                id="_IDGenRailMediumText"
                text="{railHealth>medium}"/>


            <!-- 6. QUEUE DEPTH -->
            <Text
                id="_IDGenRailQueueDepthText"
                text="{railHealth>queueDepth}"/>


            <!-- 7. CREATED ON -->
            <Text
                id="_IDGenCreatedOnText"
                text="{railHealth>createdOn}"/>

        </cells>

    </ColumnListItem>

</items>

    </Table>

</VBox>
 <!-- ===================================================== -->
            <!-- RAIL DETAILS DIALOG -->
            <!-- ===================================================== -->

            <Dialog
                id="_IDGenRailDetailsDialog"
                title="{railHealth>/selectedRail/rail} – Rail Health Details"
                contentWidth="900px"
                contentHeight="600px"
                stretchOnPhone="true"
                class="railDetailsDialog">


                <content>

                    <VBox
                        id="_IDGenRailDialogVBox"
                        width="100%"
                        class="sapUiMediumMargin">


                        <!-- ========================================= -->
                        <!-- INCOMING / OUTGOING -->
                        <!-- ========================================= -->

                        <HBox
                            id="_IDGenRailDirectionHBox"
                            width="100%"
                            justifyContent="Center"
                            class="railDirectionSegment">


                            <SegmentedButton
                                id="_IDGenRailDirectionSegment"
                                selectedKey="{railHealth>/railDetailsDirection}"
                                selectionChange=".onRailDetailsDirectionChange">


                                <items>

                                    <SegmentedButtonItem
                                        id="_IDGenIncomingButton"
                                        key="Incoming"
                                        text="Incoming"/>

                                    <SegmentedButtonItem
                                        id="_IDGenOutgoingButton"
                                        key="Outgoing"
                                        text="Outgoing"/>

                                </items>

                            </SegmentedButton>

                        </HBox>


                        <!-- ========================================= -->
                        <!-- DETAILS TABLE -->
                        <!-- ========================================= -->

                       <Table
    id="_IDGenRailDetailsTable"
    width="100%"
    inset="false"
    class="sapUiSmallMarginTop"
    items="{railHealth>/railDetails}">

    <columns>

        <Column id="_IDGenDetailsItemNumberColumn">
            <Text
                id="_IDGenDetailsItemNumberText"
                text="Item Number"/>
        </Column>

        <Column id="_IDGenDetailsProcessingStatusColumn">
            <Text
                id="_IDGenDetailsProcessingStatusText"
                text="Item Processing Status"/>
        </Column>

        <Column id="_IDGenDetailsIncomingOrderColumn">
            <Text
                id="_IDGenDetailsIncomingOrderText"
                text="Incoming Payment Order"/>
        </Column>

        <Column id="_IDGenDetailsOutgoingOrderColumn">
            <Text
                id="_IDGenDetailsOutgoingOrderText"
                text="Outgoing Payment Order"/>
        </Column>

        <Column id="_IDGenDetailsTechnicalStatusColumn">
            <Text
                id="_IDGenDetailsTechnicalStatusText"
                text="Technical Status"/>
        </Column>

        <Column id="_IDGenDetailsPreviousTechnicalStatusColumn">
            <Text
                id="_IDGenDetailsPreviousTechnicalStatusText"
                text="Previous Technical Status"/>
        </Column>

        <Column id="_IDGenDetailsTransactionTypeColumn">
            <Text
                id="_IDGenDetailsTransactionTypeText"
                text="Transaction Type"/>
        </Column>

    </columns>

    <items>

        <ColumnListItem id="_IDGenRailDetailsItem">

            <cells>

                <Text
                    id="_IDGenDetailsItemNumberValue"
                    text="{railHealth>itemNumber}"/>

                <Text
                    id="_IDGenDetailsProcessingStatusValue"
                    text="{railHealth>itemProcessingStatus}"/>

                <Text
                    id="_IDGenDetailsIncomingOrderValue"
                    text="{railHealth>incomingPaymentOrder}"/>

                <Text
                    id="_IDGenDetailsOutgoingOrderValue"
                    text="{railHealth>outgoingPaymentOrder}"/>

                <Text
                    id="_IDGenDetailsTechnicalStatusValue"
                    text="{railHealth>technicalStatus}"/>

                <Text
                    id="_IDGenDetailsPreviousTechnicalStatusValue"
                    text="{railHealth>previousTechnicalStatus}"/>

                <Text
                    id="_IDGenDetailsTransactionTypeValue"
                    text="{railHealth>transactionType}"/>

            </cells>

        </ColumnListItem>

    </items>

</Table>

                    </VBox>

                </content>


                <!-- ================================================ -->
                <!-- CLOSE -->
                <!-- ================================================ -->

                <beginButton>

                    <Button
                        id="_IDGenRailDetailsCloseButton"
                        text="Close"
                        press=".onCloseRailDetails"/>

                </beginButton>

            </Dialog>

        </VBox>

    </VBox>

</mvc:View>