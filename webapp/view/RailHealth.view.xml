    class="railSection">

               
<HBox id="_IDGenHBox96"
    justifyContent="SpaceBetween"
    alignItems="Center"
    class="sectionHeader">

    <Title id="_IDGenTitle9"
        text="Rail Health Overview"
        level="H5"/>

    <Link id="_IDGenLink"
        text="View All Rails"/>

</HBox>

                 

                    <Table id="_IDGenTable1"
                        width="100%"
                        inset="false"
                        items="{railHealth>/railOverview}">

                        <columns>

                            <Column id="_IDGenColumn" width="11rem">
                                <Text id="_IDGenText51" text="Payment Rail"/>
                            </Column>

                            <Column id="_IDGenColumn1" width="8rem">
                                <Text id="_IDGenText52" text="Status"/>
                            </Column>

                            <Column id="_IDGenColumn2" width="8rem">
                                <Text id="_IDGenText53" text="Success Rate"/>
                            </Column>

                            <Column id="_IDGenColumn3" width="9rem">
                                <Text id="_IDGenText60" text="Avg Response"/>
                            </Column>

                            <Column id="_IDGenColumn4" width="8rem">
                                <Text id="_IDGenText61" text="Volume"/>
                            </Column>

                        </columns>

                        <items>

                            <ColumnListItem id="_IDGenColumnListItem">

                                <cells>

                                    <Text id="_IDGenText62" text="{railHealth>rail}"/>

                                    <ObjectStatus id="_IDGenObjectStatus"
                                        text="{railHealth>status}"
                                        state="{
                                            = ${railHealth>status} === 'Healthy'
                                            ? 'Success'
                                            : ${railHealth>status} === 'Warning'
                                            ? 'Warning'
                                            : 'Error'
                                        }"/>

                                    <Text id="_IDGenText63" text="{railHealth>successRate}"/>

                                    <Text id="_IDGenText64" text="{railHealth>responseTime}"/>

                                    <Text id="_IDGenText65" text="{railHealth>volume}"/>

                                </cells>

                            </ColumnListItem>

                        </items>

                    </Table>

              

