</VBox>

    </FlexBox>
</VBox>
</ScrollContainer>

    </VBox>




<!-- ========================================================= -->
<!-- Rail Health Overview -->
<!-- ========================================================= -->

<VBox
    id="_IDGenRailOverviewSection"
    width="100%"
    class="railSection sapUiSmallMarginTop">

    <!-- Section Header -->
    <HBox
        id="_IDGenRailOverviewHeader"
        justifyContent="SpaceBetween"
        alignItems="Center"
        class="sectionHeader">

        <Title
            id="_IDGenRailOverviewTitle"
            text="Rail Health Overview"
            level="H5"/>

        <Link
            id="_IDGenRailOverviewLink"
            text="View All Rails"/>

    </HBox>


    <!-- Rail Health Table -->
    <Table
        id="_IDGenRailOverviewTable"
        width="100%"
        inset="false"
        items="{railHealth>/railOverview}">

        <columns>

            <Column
                id="_IDGenRailColumn"
                width="20%">
                <Text
                    id="_IDGenRailColumnText"
                    text="Payment Rail"/>
            </Column>

            <Column
                id="_IDGenStatusColumn"
                width="20%">
                <Text
                    id="_IDGenStatusColumnText"
                    text="Status"/>
            </Column>

            <Column
                id="_IDGenSuccessColumn"
                width="20%">
                <Text
                    id="_IDGenSuccessColumnText"
                    text="Success Rate"/>
            </Column>

            <Column
                id="_IDGenResponseColumn"
                width="20%">
                <Text
                    id="_IDGenResponseColumnText"
                    text="Avg Response"/>
            </Column>

            <Column
                id="_IDGenVolumeColumn"
                width="20%">
                <Text
                    id="_IDGenVolumeColumnText"
                    text="Volume"/>
            </Column>

        </columns>


        <items>

            <ColumnListItem
                id="_IDGenRailColumnListItem">

                <cells>

                    <Text
                        id="_IDGenRailText"
                        text="{railHealth>rail}"/>


                    <ObjectStatus
                        id="_IDGenRailStatus"
                        text="{railHealth>status}"
                        state="{
                            = ${railHealth>status} === 'Healthy'
                            ? 'Success'
                            : ${railHealth>status} === 'Warning'
                            ? 'Warning'
                            : 'Error'
                        }"/>


                    <Text
                        id="_IDGenRailSuccessText"
                        text="{railHealth>successRate}"/>


                    <Text
                        id="_IDGenRailResponseText"
                        text="{railHealth>responseTime}"/>


                    <Text
                        id="_IDGenRailVolumeText"
                        text="{railHealth>volume}"/>

                </cells>

            </ColumnListItem>

        </items>

    </Table>

</VBox>




</mvc:View>