<mvc:View
    controllerName="payment.dashboard.controller.RailHealth"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <VBox id="_IDGenVBox5"   width="100%"
      class="sapUiTinyMargin">

        <!-- ✅ KPI ROW -->
    <ScrollContainer id="_IDGenScrollContainer1"
     
        horizontal="false"
        vertical="false"
        class="sapUiSmallMarginBottom"
        width="100%"
        height="auto"
    >

       <VBox
    id="_IDGenRailKpiSection"
    width="100%"
    class="kpiSectionContainer">

    
    <FlexBox
        id="_IDGenRailKpiRow"
        wrap="Wrap"
        fitContainer="true"
        renderType="Bare"
        width="100%"
        class="railKpiRow"
    >

        <!-- OVERALL HEALTH -->
        <VBox
    id="_IDGenKpiOverallHealth"
    class="kpiCard kpiCardNoClick"
    width="100%"
    height="100%">

    <!-- KPI TITLE -->
    <Text
        id="_IDGenKpiOverallHealthLabel"
        text="Overall Health"
        class="kpiCardLabel"/>

    <!-- KPI VALUE + ICON -->
    <HBox
        id="_IDGenKpiOverallHealthValueRow"
        class="kpiValueRow"
        alignItems="Center"
        justifyContent="SpaceBetween">

        <Text
            id="_IDGenKpiOverallHealthValue"
            text="{railHealth>/kpis/overallHealth}"
            class="kpiCardValue kpiValueGreen"/>

        <HBox
            id="_IDGenKpiOverallHealthIconBox"
            class="kpiIconBox kpiIconGreen">

            <core:Icon
                id="_IDGenKpiOverallHealthIcon"
                src="sap-icon://heart-2"/>

        </HBox>

    </HBox>

    <!-- KPI SUBTEXT -->
    <Text
        id="_IDGenKpiOverallHealthSub"
        text="{railHealth>/kpis/overallHealthSub}"
        class="kpiCardSubtext"/>

</VBox>

        <!-- ACTIVE RAILS -->
       <VBox
    id="_IDGenKpiActiveRails"
    class="kpiCard kpiCardNoClick"
    width="100%"
    height="100%">

