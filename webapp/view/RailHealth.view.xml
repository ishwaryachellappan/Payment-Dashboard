<mvc:View
    controllerName="payment.dashboard.controller.RailHealth"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <VBox
        id="_IDGenVBox5"
        width="100%"
        class="sapUiTinyMargin">

        <!-- ========================================================= -->
        <!-- KPI SECTION -->
        <!-- ========================================================= -->

        <ScrollContainer
            id="_IDGenScrollContainer1"
            horizontal="false"
            vertical="false"
            class="sapUiSmallMarginBottom"
            width="100%"
            height="auto">

            <VBox
                id="_IDGenRailKpiSection"
                width="100%"
                class="kpiSectionContainer">

                <FlexBox
                    id="_IDGenRailKpiRow"
                    wrap="Wrap"
                    fitContainer="true"
                    renderType="Bare"
                    width="100%"
                    class="railKpiRow">

                    <!-- OVERALL HEALTH -->
                    <VBox id="_IDGenKpiOverallHealth" class="kpiCard kpiCardNoClick" width="100%" height="100%">
                        <Text id="_IDGenKpiOverallHealthLabel" text="{i18n>overallHealth}" class="kpiCardLabel"/>
                        <HBox id="_IDGenKpiOverallHealthValueRow" class="kpiValueRow" alignItems="Center" justifyContent="SpaceBetween">
                            <Text id="_IDGenKpiOverallHealthValue" text="{railHealth>/kpis/overallHealth}" class="kpiCardValue kpiValueGreen"/>
                            <HBox id="_IDGenKpiOverallHealthIconBox" class="kpiIconBox kpiIconGreen">
                                <core:Icon id="_IDGenKpiOverallHealthIcon" src="sap-icon://heart-2"/>
                            </HBox>
                        </HBox>
                        <Text id="_IDGenKpiOverallHealthSub" text="{railHealth>/kpis/overallHealthSub}" class="kpiCardSubtext"/>
                    </VBox>

                    <!-- ACTIVE RAILS -->
                    <VBox id="_IDGenKpiActiveRails" class="kpiCard kpiCardNoClick" width="100%" height="100%">
                        <Text id="_IDGenKpiActiveRailsLabel" text="{i18n>activeRails}" class="kpiCardLabel"/>
                        <HBox id="_IDGenKpiActiveRailsValueRow" class="kpiValueRow" alignItems="Center" justifyContent="SpaceBetween">
                            <Text id="_IDGenKpiActiveRailsValue" text="{railHealth>/kpis/activeRails}" class="kpiCardValue kpiValueBlue"/>
                            <HBox id="_IDGenKpiActiveRailsIconBox" class="kpiIconBox kpiIconBlue">
                                <core:Icon id="_IDGenKpiActiveRailsIcon" src="sap-icon://share-2"/>
                            </HBox>
                        </HBox>
                        <Text id="_IDGenKpiActiveRailsSub" text="{railHealth>/kpis/activeRailsSub}" class="kpiCardSubtext"/>
                    </VBox>

                    <!-- TRANSACTIONS -->
                    <VBox id="_IDGenKpiTransactions" class="kpiCard kpiCardNoClick" width="100%" height="100%">
                        <Text id="_IDGenKpiTransactionsLabel" text="{i18n>transactions}" class="kpiCardLabel"/>
                        <HBox id="_IDGenKpiTransactionsValueRow" class="kpiValueRow" alignItems="Center" justifyContent="SpaceBetween">
                            <Text id="_IDGenKpiTransactionsValue" text="{railHealth>/kpis/transactions}" class="kpiCardValue kpiValuePurple"/>
                            <HBox id="_IDGenKpiTransactionsIconBox" class="kpiIconBox kpiIconPurple">
                                <core:Icon id="_IDGenKpiTransactionsIcon" src="sap-icon://business-objects-experience"/>
                            </HBox>
                        </HBox>
                        <Text id="_IDGenKpiTransactionsSub" text="{railHealth>/kpis/transactionsSub}" class="kpiCardSubtext"/>
                    </VBox>

                    <!-- SUCCESS RATE -->
                    <VBox id="_IDGenKpiSuccessRate" class="kpiCard kpiCardNoClick" width="100%" height="100%">
                        <Text id="_IDGenKpiSuccessRateLabel" text="{i18n>successRate}" class="kpiCardLabel"/>
                        <HBox id="_IDGenKpiSuccessRateValueRow" class="kpiValueRow" alignItems="Center" justifyContent="SpaceBetween">
                            <Text id="_IDGenKpiSuccessRateValue" text="{railHealth>/kpis/successRate}" class="kpiCardValue kpiValueGreen"/>
                            <HBox id="_IDGenKpiSuccessRateIconBox" class="kpiIconBox kpiIconGreen">
                                <core:Icon id="_IDGenKpiSuccessRateIcon" src="sap-icon://accept"/>
                            </HBox>
                        </HBox>
                        <Text id="_IDGenKpiSuccessRateSub" text="{railHealth>/kpis/successRateSub}" class="kpiCardSubtext"/>
                    </VBox>

                    <!-- FAILED PAYMENTS -->
                    <VBox id="_IDGenKpiFailedPayments" class="kpiCard kpiCardNoClick" width="100%" height="100%">
                        <Text id="_IDGenKpiFailedPaymentsLabel" text="{i18n>failedPayments}" class="kpiCardLabel"/>
                        <HBox id="_IDGenKpiFailedPaymentsValueRow" class="kpiValueRow" alignItems="Center" justifyContent="SpaceBetween">
                            <Text id="_IDGenKpiFailedPaymentsValue" text="{railHealth>/kpis/failedPayments}" class="kpiCardValue kpiValueDarkRed"/>
                            <HBox id="_IDGenKpiFailedPaymentsIconBox" class="kpiIconBox kpiIconDarkRed">
                                <core:Icon id="_IDGenKpiFailedPaymentsIcon" src="sap-icon://error"/>
                            </HBox>
                        </HBox>
                        <Text id="_IDGenKpiFailedPaymentsSub" text="{railHealth>/kpis/failedPaymentsSub}" class="kpiCardSubtext"/>
                    </VBox>

                    <!-- RESPONSE TIME -->
                    <VBox id="_IDGenKpiResponseTime" class="kpiCard kpiCardNoClick" width="100%" height="100%">
                        <Text id="_IDGenKpiResponseTimeLabel" text="{i18n>responseTime}" class="kpiCardLabel"/>
                        <HBox id="_IDGenKpiResponseTimeValueRow" class="kpiValueRow" alignItems="Center" justifyContent="SpaceBetween">
                            <Text id="_IDGenKpiResponseTimeValue" text="{railHealth>/kpis/responseTime}" class="kpiCardValue kpiValueBlue"/>
                            <HBox id="_IDGenKpiResponseTimeIconBox" class="kpiIconBox kpiIconBlue">
                                <core:Icon id="_IDGenKpiResponseTimeIcon" src="sap-icon://history"/>
                            </HBox>
                        </HBox>
                        <Text id="_IDGenKpiResponseTimeSub" text="{railHealth>/kpis/responseTimeSub}" class="kpiCardSubtext"/>
                    </VBox>

                    <!-- QUEUE DEPTH -->
                    <VBox id="_IDGenKpiQueueDepth" class="kpiCard kpiCardNoClick" width="100%" height="100%">
                        <Text id="_IDGenKpiQueueDepthLabel" text="{i18n>queueDepth}" class="kpiCardLabel"/>
                        <HBox id="_IDGenKpiQueueDepthValueRow" class="kpiValueRow" alignItems="Center" justifyContent="SpaceBetween">
                            <Text id="_IDGenKpiQueueDepthValue" text="{railHealth>/kpis/queueDepth}" class="kpiCardValue kpiValueOrange"/>
                            <HBox id="_IDGenKpiQueueDepthIconBox" class="kpiIconBox kpiIconOrange">
                                <core:Icon id="_IDGenKpiQueueDepthIcon" src="sap-icon://list"/>
                            </HBox>
                        </HBox>
                        <Text id="_IDGenKpiQueueDepthSub" text="{railHealth>/kpis/queueDepthSub}" class="kpiCardSubtext"/>
                    </VBox>

                    <!-- CRITICAL ALERTS -->
                    <VBox id="_IDGenKpiCriticalAlerts" class="kpiCard kpiCardNoClick" width="100%" height="100%">
                        <Text id="_IDGenKpiCriticalAlertsLabel" text="{i18n>criticalAlerts}" class="kpiCardLabel"/>
                        <HBox id="_IDGenKpiCriticalAlertsValueRow" class="kpiValueRow" alignItems="Center" justifyContent="SpaceBetween">
                            <Text id="_IDGenKpiCriticalAlertsValue" text="{railHealth>/kpis/alerts}" class="kpiCardValue kpiValueDarkRed"/>
                            <HBox id="_IDGenKpiCriticalAlertsIconBox" class="kpiIconBox kpiIconDarkRed">
                                <core:Icon id="_IDGenKpiCriticalAlertsIcon" src="sap-icon://bell"/>
                            </HBox>
                        </HBox>
                        <Text id="_IDGenKpiCriticalAlertsSub" text="{railHealth>/kpis/alertsSub}" class="kpiCardSubtext"/>
                    </VBox>

                </FlexBox>

            </VBox>

        </ScrollContainer>

        <!-- ========================================================= -->
        <!-- RAIL HEALTH OVERVIEW -->
        <!-- ========================================================= -->

        <VBox
            id="_IDGenRailOverviewSection"
            width="100%"
            class="railSection railHealthOverviewSection sapUiSmallMarginTop">

            <HBox
                id="_IDGenRailOverviewHeader"
                justifyContent="SpaceBetween"
                alignItems="Center"
                class="sectionHeader">
                <Title
                    id="_IDGenRailOverviewTitle"
                    text="{i18n>railHealthOverview}"
                    level="H5"/>
            </HBox>

            <!-- SEARCH / FILTER -->
            <VBox
                id="_IDGenRailSearchSection"
                width="100%"
                class="railSearchSection sapUiSmallMarginTop sapUiSmallMarginBottom">

                <Title
                    id="_IDGenRailSearchTitle"
                    text="Search rails"
                    level="H5"
                    class="railSearchTitle"/>

                <HBox
                    id="_IDGenRailSearchFilters"
                    width="100%"
                    wrap="Wrap"
                    class="railSearchFilters">

                    <VBox id="_IDGenRailFilterBox" class="railFilterItem">
                        <Label id="_IDGenRailFilterLabel" text="Rail"/>
                        <Select
                            id="_IDGenRailFilterSelect"
                            width="100%"
                            selectedKey="{railHealth>/railFilters/rail}"
                            change=".onRailFilterChange"
                            items="{railHealth>/availableRails}">
                            <core:Item id="_IDGenItem"
                                key="{railHealth>key}"
                                text="{railHealth>text}"/>
                        </Select>
                    </VBox>

                    <VBox id="_IDGenRailStatusFilterBox" class="railFilterItem">
                        <Label id="_IDGenRailStatusFilterLabel" text="Status"/>
                        <Select
                            id="_IDGenRailStatusFilterSelect"
                            width="100%"
                            selectedKey="{railHealth>/railFilters/status}"
                            change=".onRailFilterChange">
                            <core:Item id="_IDGenStatusAll" key="All" text="All"/>
                            <core:Item id="_IDGenStatusHealthy" key="Healthy" text="Healthy"/>
                            <core:Item id="_IDGenStatusWarning" key="Warning" text="Warning"/>
                            <core:Item id="_IDGenStatusCritical" key="Critical" text="Critical"/>
                        </Select>
                    </VBox>

                </HBox>

            </VBox>

            <!-- RAIL HEALTH TABLE -->
            <VBox
                id="_IDGenRailTableContainer"
                width="100%"
                class="railTableContainer">

                <Table
                    id="_IDGenRailOverviewTable"
                    width="100%"
                    inset="false"
                    mode="None"
                    class="railOverviewTable"
                    noDataText="No rails for the selected filter"
                    items="{path: 'railHealth>/filteredRailOverview'}">

                    <columns>
                        <Column id="_IDGenRailSelectColumn" width="3rem" hAlign="Center">
                            <header>
                                <CheckBox
                                    id="_IDGenRailSelectAll"
                                    selected="{railHealth>/allRailsSelected}"
                                    select=".onRailSelectAll"/>
                            </header>
                        </Column>
                        <!-- PAYMENT RAIL -->
    <Column
        id="_IDGenRailChannelColumn"
        width="15%">
      
        <Text
            id="_IDGenRailChannelColumnText"
            text="Payment Rail"/>
    </Column>
                        <Column id="_IDGenStatusColumn" width="15%">
                            <Text id="_IDGenStatusColumnText" text="Status"/>
                        </Column>
                        <Column id="_IDGenSuccessColumn" width="15%">
                            <Text id="_IDGenSuccessColumnText" text="Success Rate"/>
                        </Column>
                        <Column id="_IDGenResponseColumn" width="15%">
                            <Text id="_IDGenResponseColumnText" text="Avg Response"/>
                        </Column>
                   
                        <Column id="_IDGenQueueDepthColumn" width="15%">
                            <Text id="_IDGenQueueDepthColumnText" text="Queue Depth"/>
                        </Column>
                        <Column id="_IDGenCreatedOnColumn" width="15%">
                            <Text id="_IDGenCreatedOnColumnText" text="Created On"/>
                        </Column>
                             <Column id="_IDGenRailMediumColumn" width="15%">
                            <Text id="_IDGenRailMediumColumnText" text="Medium"/>
                        </Column>
                         <!-- FORMAT -->
    <Column
        id="_IDGenRailFormatColumn"
        width="15%"
        hAlign="Begin">
        <Text
            id="_IDGenRailFormatColumnText"
            text="Format"/>
    </Column>
                    </columns>

                    <items>
                        <ColumnListItem id="_IDGenColumnListItem1"
                            type="Navigation"
                            press=".onRailRowPress">
                            <cells>
                                <CheckBox id="_IDGenCheckBox"
                                    selected="{railHealth>selected}"
                                    select=".onRailRowSelect"/>
                                <Text id="_IDGenText" text="{railHealth>channel}"/>
                                <Text id="_IDGenText1" text="{railHealth>status}"/>
                                <Text id="_IDGenText2" text="{railHealth>successRate}"/>
                                <Text id="_IDGenText3" text="{railHealth>responseTime}"/>
                               
                                <Text id="_IDGenText21" text="{railHealth>queueDepth}"/>
                                <Text id="_IDGenText28" text="{railHealth>createdOn}"/>
                                 <Text id="_IDGenText4" text="{railHealth>medium}"/>
                                  <!-- 8. FORMAT -->
    <Text
        id="_IDGenTextFormat"
        text="{railHealth>format}"/>
                            </cells>
                        </ColumnListItem>
                    </items>

                </Table>

            </VBox>

            <!-- ===================================================== -->
            <!-- RAIL → PAYMENT ORDERS DIALOG -->
            <!-- ===================================================== -->

          <Dialog
    id="_IDGenRailDetailsDialog"
    title="{railHealth>/railOrdersTitle}"
    contentWidth="1400px"
    contentHeight="680px"
    resizable="true"
    draggable="true"
    stretchOnPhone="true"
    class="railDetailsDialog">

                <content>

                    <VBox
                        id="_IDGenRailDialogVBox"
                        width="100%"
                        class="sapUiSmallMargin">

                        <Text
                            id="_IDGenRailOrdersInfo"
                            text="{railHealth>/railOrdersInfo}"
                            class="sapUiTinyMarginBottom"/>

                       <ScrollContainer
    id="_IDGenRailOrdersScroll"
    width="100%"
    horizontal="true"
    vertical="false">

    <Table
        id="_IDGenRailDetailsTable"
        width="1350px"
        inset="false"
        sticky="ColumnHeaders"
        growing="true"
        growingThreshold="50"
        growingScrollToLoad="true"
        busy="{railHealth>/railOrdersBusy}"
        busyIndicatorDelay="0"
        noDataText="No payment orders found for this channel"
        items="{railHealth>/railOrders}"
        class="railPaymentOrdersTable">

        <columns>

            <!-- ARROW -->
            <Column
                id="_IDGenOrdArrowCol"
                width="3rem"
                hAlign="Center"/>

            <!-- ORDER KEY -->
            <Column
                id="_IDGenOrdKeyCol"
                width="15rem">

                <Text
                    id="_IDGenOrdKeyHdr"
                    text="Order Key"/>

            </Column>

            <!-- PAYMENT ORDER NO -->
            <Column
                id="_IDGenOrdNoCol"
                width="10rem">

                <Text
                    id="_IDGenOrdNoHdr"
                    text="Payment Order No."/>

            </Column>

            <!-- PAYMENT ORDER DATE -->
            <Column
                id="_IDGenOrdDateCol"
                width="11rem">

                <Text
                    id="_IDGenOrdDateHdr"
                    text="Payment Order Date"/>

            </Column>

            <!-- TECHNICAL STATUS -->
            <Column
                id="_IDGenOrdStatusCol"
                width="12rem">

                <Text
                    id="_IDGenOrdStatusHdr"
                    text="Technical Status"/>

            </Column>

            <!-- CREATED ON -->
            <Column
                id="_IDGenOrdCreatedOnCol"
                width="10rem">

                <Text
                    id="_IDGenOrdCreatedOnHdr"
                    text="Created On"/>

            </Column>

            <!-- CREATED BY -->
            <Column
                id="_IDGenOrdCreatedByCol"
                width="10rem">

                <Text
                    id="_IDGenOrdCreatedByHdr"
                    text="Created By"/>

            </Column>

            <!-- RELEASED BY -->
            <Column
                id="_IDGenOrdReleasedByCol"
                width="10rem">

                <Text
                    id="_IDGenOrdReleasedByHdr"
                    text="Released By"/>

            </Column>

            <!-- ORDER FORMAT -->
            <Column
                id="_IDGenOrdFormatCol"
                width="10rem">

                <Text
                    id="_IDGenOrdFormatHdr"
                    text="Order Format"/>

            </Column>

            <!-- MEDIUM -->
            <Column
                id="_IDGenOrdMediumCol"
                width="8rem">

                <Text
                    id="_IDGenOrdMediumHdr"
                    text="Medium"/>

            </Column>

            <!-- CHANNEL -->
            <Column
                id="_IDGenOrdChannelCol"
                width="8rem">

                <Text
                    id="_IDGenOrdChannelHdr"
                    text="Channel"/>

            </Column>

        </columns>

        <items>

            <ColumnListItem
                id="_IDGenColumnListItem3"
                type="Active"
                press=".onRailOrderPress">

                <cells>

                    <!-- ARROW -->
                    <core:Icon
                        id="_IDGenIcon"
                        src="sap-icon://navigation-right-arrow"
                        color="Default"
                        tooltip="View items"/>

                    <!-- ORDER KEY -->
                    <Text
                        id="_IDGenText36"
                        text="{railHealth>orderKey}"/>

                    <!-- PAYMENT ORDER NO -->
                    <Text
                        id="_IDGenText37"
                        text="{railHealth>paymentOrderNumber}"/>

                    <!-- PAYMENT ORDER DATE -->
                    <Text
                        id="_IDGenText48"
                        text="{railHealth>paymentOrderDate}"/>

                    <!-- TECHNICAL STATUS -->
                    <ObjectStatus
                        id="_IDGenObjectStatus"
                        text="{railHealth>technicalStatusText}"
                        state="{railHealth>technicalStatusState}"/>

                    <!-- CREATED ON -->
                    <Text
                        id="_IDGenText49"
                        text="{railHealth>createdOn}"/>

                    <!-- CREATED BY -->
                    <Text
                        id="_IDGenText50"
                        text="{railHealth>createdBy}"/>

                    <!-- RELEASED BY -->
                    <Text
                        id="_IDGenText51"
                        text="{railHealth>releasedBy}"/>

                    <!-- ORDER FORMAT -->
                    <Text
                        id="_IDGenText52"
                        text="{railHealth>orderFormat}"/>

                    <!-- MEDIUM -->
                    <Text
                        id="_IDGenText53"
                        text="{railHealth>medium}"/>

                    <!-- CHANNEL -->
                    <Text
                        id="_IDGenText60"
                        text="{railHealth>channel}"/>

                </cells>

            </ColumnListItem>

        </items>

    </Table>

</ScrollContainer>

                    </VBox>

                </content>

                <endButton>
                    <Button
                        id="_IDGenRailDetailsCloseButton"
                        text="Close"
                        press=".onCloseRailDetails"/>
                </endButton>

            </Dialog>

            <!-- ===================================================== -->
            <!-- PAYMENT ORDER → ITEM DETAILS DIALOG -->
            <!-- ===================================================== -->

          <Dialog
    id="_IDGenOrderItemsDialog"
    title="{railHealth>/orderItemsTitle}"
    contentWidth="1300px"
    contentHeight="600px"
    resizable="true"
    draggable="true"
    stretchOnPhone="true"
    class="railDetailsDialog">

                <content>

                    <VBox
                        id="_IDGenOrderItemsVBox"
                        width="100%"
                        class="sapUiSmallMargin">

                        <Text
                            id="_IDGenOrderItemsInfo"
                            text="{railHealth>/orderItemsInfo}"
                            class="sapUiTinyMarginBottom"/>

                        <!-- INCOMING / OUTGOING -->
                        <HBox
                            id="_IDGenOrderItemsDirectionBox"
                            width="100%"
                            justifyContent="Center"
                            class="sapUiSmallMarginTopBottom">

                            <SegmentedButton
                                id="_IDGenOrderItemsDirection"
                                width="20rem"
                                selectedKey="{railHealth>/orderItemsDirection}"
                                selectionChange=".onOrderItemsDirectionChange">
                                <items>
                                    <SegmentedButtonItem
                                        id="_IDGenOrderItemsIncoming"
                                        key="Incoming"
                                        text="{railHealth>/incomingLabel}"/>
                                    <SegmentedButtonItem
                                        id="_IDGenOrderItemsOutgoing"
                                        key="Outgoing"
                                        text="{railHealth>/outgoingLabel}"/>
                                </items>
                            </SegmentedButton>

                        </HBox>

                        <!-- ITEMS TABLE -->
                       <ScrollContainer
    id="_IDGenOrderItemsScroll"
    width="100%"
    horizontal="true"
    vertical="false">

    <Table
        id="_IDGenOrderItemsTable"
        width="1250px"
        inset="false"
        sticky="ColumnHeaders"
        growing="true"
        growingThreshold="50"
        growingScrollToLoad="true"
        busy="{railHealth>/orderItemsBusy}"
        busyIndicatorDelay="0"
        noDataText="{railHealth>/orderItemsNoDataText}"
        items="{railHealth>/orderItems}"
        class="railOrderItemsTable">

        <columns>

            <!-- PAYMENT ITEM DATE -->
            <Column
                id="_IDGenItmDateCol"
                width="11rem">

                <Text
                    id="_IDGenItmDateHdr"
                    text="Payment Item Date"/>

            </Column>

            <!-- CLEARING AREA -->
            <Column
                id="_IDGenItmCaCol"
                width="9rem">

                <Text
                    id="_IDGenItmCaHdr"
                    text="Clearing Area"/>

            </Column>

            <!-- ITEM NUMBER -->
            <Column
                id="_IDGenItmNoCol"
                width="10rem">

                <Text
                    id="_IDGenItmNoHdr"
                    text="Item Number"/>

            </Column>

            <!-- ITEM PROCESSING STATUS -->
            <Column
                id="_IDGenItmStatusCol"
                width="14rem">

                <Text
                    id="_IDGenItmStatusHdr"
                    text="Item Processing Status"/>

            </Column>

            <!-- INCOMING PAYMENT ORDER -->
            <Column
                id="_IDGenItmInPoCol"
                width="13rem"
                visible="{railHealth>/showIncomingPoColumn}">

                <Text
                    id="_IDGenItmInPoHdr"
                    text="Incoming Payment Order"/>

            </Column>

            <!-- OUTGOING PAYMENT ORDER -->
            <Column
                id="_IDGenItmOutPoCol"
                width="13rem"
                visible="{railHealth>/showOutgoingPoColumn}">

                <Text
                    id="_IDGenItmOutPoHdr"
                    text="Outgoing Payment Order"/>

            </Column>

            <!-- TECHNICAL STATUS -->
            <Column
                id="_IDGenItmTechCol"
                width="12rem">

                <Text
                    id="_IDGenItmTechHdr"
                    text="Technical Status"/>

            </Column>

            <!-- TRANSACTION TYPE -->
            <Column
                id="_IDGenItmTxTypeCol"
                width="11rem">

                <Text
                    id="_IDGenItmTxTypeHdr"
                    text="Transaction Type"/>

            </Column>

            <!-- VALUE DATE -->
            <Column
                id="_IDGenItmValDateCol"
                width="10rem">

                <Text
                    id="_IDGenItmValDateHdr"
                    text="Value Date"/>

            </Column>

            <!-- AMOUNT -->
            <Column
                id="_IDGenItmAmtCol"
                width="11rem"
                hAlign="End">

                <Text
                    id="_IDGenItmAmtHdr"
                    text="Amount"/>

            </Column>

        </columns>

        <items>

            <ColumnListItem
                id="_IDGenColumnListItem4">

                <cells>

                    <!-- PAYMENT ITEM DATE -->
                    <Text
                        id="_IDGenText61"
                        text="{railHealth>paymentItemDate}"/>

                    <!-- CLEARING AREA -->
                    <Text
                        id="_IDGenText62"
                        text="{railHealth>clearingArea}"/>

                    <!-- ITEM NUMBER -->
                    <Text
                        id="_IDGenText63"
                        text="{railHealth>itemNumber}"/>

                    <!-- ITEM PROCESSING STATUS -->
                    <ObjectStatus
                        id="_IDGenObjectStatus1"
                        text="{railHealth>itemStatusText}"
                        state="{railHealth>itemStatusState}"/>

                    <!-- INCOMING PAYMENT ORDER -->
                    <Text
                        id="_IDGenText64"
                        text="{railHealth>incomingPaymentOrder}"/>

                    <!-- OUTGOING PAYMENT ORDER -->
                    <Text
                        id="_IDGenText65"
                        text="{railHealth>outgoingPaymentOrder}"/>

                    <!-- TECHNICAL STATUS -->
                    <ObjectStatus
                        id="_IDGenObjectStatus2"
                        text="{railHealth>technicalStatusText}"
                        state="{railHealth>technicalStatusState}"/>

                    <!-- TRANSACTION TYPE -->
                    <Text
                        id="_IDGenText66"
                        text="{railHealth>transactionType}"/>

                    <!-- VALUE DATE -->
                    <Text
                        id="_IDGenText67"
                        text="{railHealth>valueDate}"/>

                    <!-- AMOUNT -->
                    <ObjectNumber
                        id="_IDGenObjectNumber"
                        number="{railHealth>amount}"
                        unit="{railHealth>currency}"/>

                </cells>

            </ColumnListItem>

        </items>

    </Table>

</ScrollContainer>

                    </VBox>

                </content>

                <endButton>
                    <Button
                        id="_IDGenOrderItemsCloseButton"
                        text="Close"
                        press=".onCloseOrderItems"/>
                </endButton>

            </Dialog>

        </VBox>

    </VBox>

</mvc:View>